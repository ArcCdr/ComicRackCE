<Project Sdk="Microsoft.NET.Sdk">
  <!-- Throwing facade of the reference assemblies PresentationCore and WindowsBase of the Windows Desktop pack (P4.17.3), generated by mac/tools/facade-gen into Generated/.
       The WindowsBase types are declared here: the runtime's own WindowsBase.dll (4.0.0.0) wins over an app-local file of that name on a framework-dependent start. Scripts of the .NET Framework
       name the WPF assemblies at the top level (clr.AddReference('PresentationCore')); without them such a plug-in does not load at all. net10/macOS only; the net48 build never sees it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PresentationCore</RootNamespace>
    <AssemblyName>PresentationCore</AssemblyName>
    <AssemblyVersion>10.0.0.0</AssemblyVersion>
    <FileVersion>10.0.0.0</FileVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>false</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\cYo.Compat.Xaml\cYo.Compat.Xaml.csproj" />
  </ItemGroup>
  <!-- The generated bodies of a derived class call internal constructors of its base in another facade (WPF reaches them through InternalsVisibleTo too). -->
  <ItemGroup>
    <InternalsVisibleTo Include="PresentationFramework" />
  </ItemGroup>
</Project>
