<Project Sdk="Microsoft.NET.Sdk">
  <!-- Throwing facade of the reference assembly PresentationFramework of the Windows Desktop pack (P4.17.3), generated by mac/tools/facade-gen into Generated/. Scripts of the .NET Framework
       name the WPF assemblies at the top level (clr.AddReference('PresentationFramework')); without them such a plug-in does not load at all. net10/macOS only; the net48 build never sees it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PresentationFramework</RootNamespace>
    <AssemblyName>PresentationFramework</AssemblyName>
    <AssemblyVersion>10.0.0.0</AssemblyVersion>
    <FileVersion>10.0.0.0</FileVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>false</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\cYo.Compat.PresentationCore\cYo.Compat.PresentationCore.csproj" />
    <ProjectReference Include="..\cYo.Compat.Xaml\cYo.Compat.Xaml.csproj" />
  </ItemGroup>
</Project>
