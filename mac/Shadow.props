<Project>
  <!-- Shared by the shadow projects (linked-source builds of the original Core sources).
       CensusPass selects what is measured:
         A  net10.0-windows + WinForms (builds on macOS, never runs): only the .NET Framework -> .NET 10 gaps
         B  net10.0 (the real target): everything, including the Windows-only APIs
       Default is B. Usage: dotnet build -p:CensusPass=A -->
  <PropertyGroup>
    <CensusPass Condition="'$(CensusPass)' == ''">B</CensusPass>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CensusPass)' == 'A'">
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DefineConstants>$(DefineConstants);CENSUS_PASS_A</DefineConstants>
    <!-- WinForms designer-serialization analyzer (new in the .NET 10 SDK): not a compile gap, only noise for linked sources -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CensusPass)' == 'B'">
    <TargetFramework>net10.0</TargetFramework>
    <DefineConstants>$(DefineConstants);CENSUS_PASS_B</DefineConstants>
  </PropertyGroup>
  <!-- Pass B has no System.Windows.Forms and no System.Drawing.Common: the stand-ins provide the slices that the Core uses
       (cYo.Compat.Forms, M1.1; cYo.Compat.Drawing, M1.2a). Pass A uses the real ones (net10.0-windows), so it must not see them. -->
  <ItemGroup Condition="'$(CensusPass)' == 'B'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)cYo.Compat.Forms\cYo.Compat.Forms.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)cYo.Compat.Drawing\cYo.Compat.Drawing.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <Deterministic>false</Deterministic>
  </PropertyGroup>
  <!-- Warnings that occur only in the linked original sources (decompiled code: no CLS attributes, BinaryFormatter, unused fields, ...).
       Measured by a clean build (P0.3); mac-owned projects (no Shadow.props) keep every warning. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CS3001;CS3002;CS3003;CS3009;SYSLIB0003;SYSLIB0004;SYSLIB0021;SYSLIB0050;CA2022;CS0649;CS0472;CS0169;CS0114;CS0659;CS1717;CS8632;CS8981</NoWarn>
  </PropertyGroup>
</Project>
