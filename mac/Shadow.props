<Project>
  <!-- Shared by the shadow projects (linked-source builds of the original Core sources).
       CensusPass selects what is measured:
         A  net10.0-windows + WinForms (builds on macOS, never runs): only the .NET Framework -> .NET 10 gaps
         B  net10.0 (the real target): everything, including the Windows-only APIs
       Default is B. Usage: dotnet build -p:CensusPass=A -->
  <PropertyGroup>
    <CensusPass Condition="'$(CensusPass)' == ''">B</CensusPass>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CensusPass)' == 'A'">
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DefineConstants>$(DefineConstants);CENSUS_PASS_A</DefineConstants>
    <!-- WinForms designer-serialization analyzer (new in the .NET 10 SDK): not a compile gap, only noise for linked sources -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CensusPass)' == 'B'">
    <TargetFramework>net10.0</TargetFramework>
    <DefineConstants>$(DefineConstants);CENSUS_PASS_B</DefineConstants>
  </PropertyGroup>
  <!-- Pass B has no System.Windows.Forms: the types-only stand-in provides the slice that the Core uses (M1.1).
       Pass A uses the real WinForms (net10.0-windows), so it must not see the stand-in. -->
  <ItemGroup Condition="'$(CensusPass)' == 'B'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)cYo.Compat.Forms\cYo.Compat.Forms.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <Deterministic>false</Deterministic>
  </PropertyGroup>
</Project>
