<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- .NET (JIT, ReadyToRun fixups) and IronPython (dynamic code) need these under the hardened runtime. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- Ad-hoc signed libraries have no team id, so library validation rejects every dylib (libhostfxr, libSkiaSharp, libpdfium).
	     Drop this once M2.5 signs with a Developer ID (one team id for the executable and all libraries). -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
