<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:ComicRack.Mac.Controls"
                    xmlns:conv="clr-namespace:Avalonia.Controls.Converters;assembly=Avalonia.Controls">
  <!-- Control themes of the custom controls and of the tree item (C-TREE-1). Colours only through Cr resources. -->

  <!-- Toolbar buttons draw themselves (CrToolButton.Render); the template only has to exist so that the base button theme does not apply. -->
  <ControlTheme x:Key="{x:Type c:CrToolButton}" TargetType="c:CrToolButton">
    <Setter Property="Template">
      <ControlTemplate>
        <Panel />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:CrSplitButton}" TargetType="c:CrSplitButton" BasedOn="{StaticResource {x:Type c:CrToolButton}}" />

  <!-- Group box: the header is drawn by the control (24 high); the content sits below it and is hidden while collapsed. -->
  <ControlTheme x:Key="{x:Type c:CrCollapsibleGroup}" TargetType="c:CrCollapsibleGroup">
    <Setter Property="Foreground" Value="{DynamicResource Cr.ControlTextBrush}" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter"
                          Margin="0,24,0,0"
                          Padding="{TemplateBinding Padding}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          IsVisible="{TemplateBinding IsExpanded}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- The chevron of a tree item: the original's SimpleArrowRight and SimpleArrowDown images. -->
  <ControlTheme x:Key="CrTreeChevron" TargetType="ToggleButton">
    <Setter Property="Width" Value="16" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <c:CrIcon Name="Right" IconName="SimpleArrowRight" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <c:CrIcon Name="Down" IconName="SimpleArrowDown" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:checked /template/ c|CrIcon#Right">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:checked /template/ c|CrIcon#Down">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

  <!-- Tree item: rows are the item font height plus 8, the selected label is bold, the arrow is the original's image, and the selection is the
       StyledRenderer look (frame and flat fill, focused or unfocused colour). -->
  <ControlTheme x:Key="{x:Type TreeViewItem}" TargetType="TreeViewItem">
    <ControlTheme.Resources>
      <conv:MarginMultiplierConverter x:Key="CrTreeIndent" Indent="16" Left="True" />
    </ControlTheme.Resources>
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Cr.WindowTextBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource Cr.FontSize.Item}" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel>
          <Border Name="PART_LayoutRoot"
                  Height="{x:Static c:ChromeMetrics.DefaultTreeRowHeight}"
                  Background="Transparent"
                  Focusable="True"
                  TemplatedControl.IsTemplateFocusTarget="True">
            <Panel>
              <c:StyledSelectionVisual />
              <Grid Name="PART_Header"
                    ColumnDefinitions="16,*"
                    Margin="{TemplateBinding Level, Converter={StaticResource CrTreeIndent}}">
                <ToggleButton Name="PART_ExpandCollapseChevron"
                              Theme="{StaticResource CrTreeChevron}"
                              IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}" />
                <ContentPresenter Name="PART_HeaderPresenter"
                                  Grid.Column="1"
                                  Margin="2,0,2,0"
                                  VerticalAlignment="Center"
                                  Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                  Foreground="{TemplateBinding Foreground}" />
              </Grid>
            </Panel>
          </Border>
          <ItemsPresenter Name="PART_ItemsPresenter"
                          IsVisible="{TemplateBinding IsExpanded}"
                          ItemsPanel="{TemplateBinding ItemsPanel}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:empty /template/ ToggleButton#PART_ExpandCollapseChevron">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="^:selected /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Foreground" Value="{DynamicResource Cr.GrayTextBrush}" />
    </Style>
  </ControlTheme>

  <!-- Check box: the Windows 10 look, a 13 unit box (white with a dark border and a black check; the dark theme fills the checked box with the
       accent), label to the right. Brushes are the base theme's own keys, which CrControlResources.* sets from the Cr tokens. -->
  <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
    <Setter Property="Padding" Value="4,0,0,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource CheckBoxForegroundUnchecked}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="17" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,*" Background="{TemplateBinding Background}">
          <Border Name="PART_Box"
                  Width="13"
                  Height="13"
                  Margin="0,2,0,2"
                  VerticalAlignment="Center"
                  BorderThickness="1"
                  Background="{DynamicResource CheckBoxCheckBackgroundFillUnchecked}"
                  BorderBrush="{DynamicResource CheckBoxCheckBackgroundStrokeUnchecked}">
            <Panel>
              <Path Name="CheckGlyph"
                    Data="M 2,5.5 L 4.5,8 L 9.5,3"
                    Stroke="{DynamicResource CheckBoxCheckGlyphForegroundChecked}"
                    StrokeThickness="1.6"
                    IsVisible="False" />
              <Rectangle Name="IndeterminateGlyph"
                         Width="7"
                         Height="7"
                         Fill="{DynamicResource CheckBoxCheckGlyphForegroundIndeterminate}"
                         IsVisible="False" />
            </Panel>
          </Border>
          <ContentPresenter Name="PART_ContentPresenter"
                            Grid.Column="1"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            RecognizesAccessKey="True" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Box">
      <Setter Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillUncheckedPointerOver}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxCheckBackgroundStrokeUncheckedPointerOver}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Box">
      <Setter Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillUncheckedPressed}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxCheckBackgroundStrokeUncheckedPressed}" />
    </Style>
    <Style Selector="^:checked /template/ Border#PART_Box">
      <Setter Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillChecked}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxCheckBackgroundStrokeChecked}" />
    </Style>
    <Style Selector="^:checked:pointerover /template/ Border#PART_Box">
      <Setter Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillCheckedPointerOver}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxCheckBackgroundStrokeCheckedPointerOver}" />
    </Style>
    <Style Selector="^:checked /template/ Path#CheckGlyph">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:indeterminate /template/ Border#PART_Box">
      <Setter Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillIndeterminate}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxCheckBackgroundStrokeIndeterminate}" />
    </Style>
    <Style Selector="^:indeterminate /template/ Rectangle#IndeterminateGlyph">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource CheckBoxForegroundUncheckedDisabled}" />
    </Style>
    <Style Selector="^:disabled /template/ Border#PART_Box">
      <Setter Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillUncheckedDisabled}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxCheckBackgroundStrokeUncheckedDisabled}" />
    </Style>
    <Style Selector="^:disabled /template/ Path#CheckGlyph">
      <Setter Property="Stroke" Value="{DynamicResource CheckBoxCheckGlyphForegroundCheckedDisabled}" />
    </Style>
  </ControlTheme>

  <!-- Radio button: a 13 unit circle with a 5 unit dot. -->
  <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton">
    <Setter Property="Padding" Value="4,0,0,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RadioButtonForeground}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="17" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,*" Background="{TemplateBinding Background}">
          <Panel Width="13" Height="13" Margin="0,2,0,2" VerticalAlignment="Center">
            <Ellipse Name="PART_Circle"
                     StrokeThickness="1"
                     Fill="{DynamicResource RadioButtonOuterEllipseFill}"
                     Stroke="{DynamicResource RadioButtonOuterEllipseStroke}" />
            <Ellipse Name="PART_Dot"
                     Width="5"
                     Height="5"
                     Fill="{DynamicResource RadioButtonCheckGlyphFill}"
                     IsVisible="False" />
          </Panel>
          <ContentPresenter Name="PART_ContentPresenter"
                            Grid.Column="1"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            RecognizesAccessKey="True" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Ellipse#PART_Circle">
      <Setter Property="Fill" Value="{DynamicResource RadioButtonOuterEllipseFillPointerOver}" />
      <Setter Property="Stroke" Value="{DynamicResource RadioButtonOuterEllipseStrokePointerOver}" />
    </Style>
    <Style Selector="^:pressed /template/ Ellipse#PART_Circle">
      <Setter Property="Fill" Value="{DynamicResource RadioButtonOuterEllipseFillPressed}" />
      <Setter Property="Stroke" Value="{DynamicResource RadioButtonOuterEllipseStrokePressed}" />
    </Style>
    <Style Selector="^:checked /template/ Ellipse#PART_Circle">
      <Setter Property="Fill" Value="{DynamicResource RadioButtonOuterEllipseCheckedFill}" />
      <Setter Property="Stroke" Value="{DynamicResource RadioButtonOuterEllipseCheckedStroke}" />
    </Style>
    <Style Selector="^:checked /template/ Ellipse#PART_Dot">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource RadioButtonForegroundDisabled}" />
    </Style>
    <Style Selector="^:disabled /template/ Ellipse#PART_Circle">
      <Setter Property="Fill" Value="{DynamicResource RadioButtonOuterEllipseFillDisabled}" />
      <Setter Property="Stroke" Value="{DynamicResource RadioButtonOuterEllipseStrokeDisabled}" />
    </Style>
    <Style Selector="^:disabled /template/ Ellipse#PART_Dot">
      <Setter Property="Fill" Value="{DynamicResource RadioButtonCheckGlyphFillDisabled}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
