<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ComicRack.Mac.Controls">
  <!-- The control themes of the chrome controls, one per control type and variant, keyed "<ControlTypeName>.<Variant>" (chrome-architecture.md
       section 4). ChromeVariants.Bind gives every chrome control the theme of its element's variant (Themes/ChromeVariants.cs), so flipping an
       element is a change of Theme and nothing else. Original is the WinForms look and exists for every control; a control that draws itself in
       Render has an empty Original theme (its look is in C# from the Cr tokens). Native exists for every element (ChromeVariants.NativeAvailable)
       and leans on the stock theme's own brushes (SystemControl*). Added after the base theme, so the
       BasedOn lookups of the stock themes work. -->
  <Styles.Resources>
    <ResourceDictionary>

      <!-- Toolbar -->
      <ControlTheme x:Key="CrToolBar.Original" TargetType="c:CrToolBar" />
      <ControlTheme x:Key="CrToolSeparator.Original" TargetType="c:CrToolSeparator" />
      <ControlTheme x:Key="CrSearchBox.Original" TargetType="c:CrSearchBox" />

      <!-- Toolbar buttons draw themselves (CrToolButton.Render); the template only has to exist so that the base button theme does not apply. -->
      <ControlTheme x:Key="CrToolButton.Original" TargetType="c:CrToolButton">
        <Setter Property="Template">
          <ControlTemplate>
            <Panel />
          </ControlTemplate>
        </Setter>
      </ControlTheme>
      <ControlTheme x:Key="CrSplitButton.Original" TargetType="c:CrSplitButton" BasedOn="{StaticResource CrToolButton.Original}" />
      <ControlTheme x:Key="CrDropDownButton.Original" TargetType="c:CrDropDownButton" BasedOn="{StaticResource CrToolButton.Original}" />

      <!-- Tab bar -->
      <ControlTheme x:Key="CrTabBar.Original" TargetType="c:CrTabBar" />

      <!-- Status bar: Native is a flat bar in the stock theme's chrome colours with a one unit top line, and flat segments. -->
      <ControlTheme x:Key="CrStatusBar.Original" TargetType="c:CrStatusBar" />
      <ControlTheme x:Key="CrStatusSlot.Original" TargetType="c:CrStatusSlot" />
      <ControlTheme x:Key="CrStatusBar.Native" TargetType="c:CrStatusBar" BasedOn="{StaticResource CrStatusBar.Original}">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      </ControlTheme>
      <ControlTheme x:Key="CrStatusSlot.Native" TargetType="c:CrStatusSlot" BasedOn="{StaticResource CrStatusSlot.Original}">
        <Setter Property="Sunken" Value="False" />
      </ControlTheme>

      <!-- Tree: the rows draw their own selection (StyledSelectionVisual) and counters (CrGaugeStrip); the tree item theme is the Tree pack (Stock/CrTree.*.axaml). -->
      <ControlTheme x:Key="CrTreeView.Original" TargetType="c:CrTreeView" BasedOn="{StaticResource {x:Type TreeView}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      </ControlTheme>
      <ControlTheme x:Key="StyledSelectionVisual.Original" TargetType="c:StyledSelectionVisual" />
      <ControlTheme x:Key="CrTreeRow.Original" TargetType="c:CrTreeRow" />
      <ControlTheme x:Key="CrGaugeStrip.Original" TargetType="c:CrGaugeStrip" />

      <!-- Rating editor: draws itself (CrRatingStars.Render) from the Cr tokens and the StarYellow image. -->
      <ControlTheme x:Key="CrRatingStars.Original" TargetType="c:CrRatingStars" />

      <!-- Spin buttons of the number boxes: two flat halves drawn by the control from the button tokens. -->
      <ControlTheme x:Key="CrSpinButton.Original" TargetType="c:CrSpinButton" />

      <!-- Combo boxes of the editors: entries with a picture and a line above them (ValueItem). -->
      <ControlTheme x:Key="CrValueComboBox.Original" TargetType="c:CrValueComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="ItemTemplate">
          <DataTemplate x:DataType="c:ValueItem">
            <Border BorderBrush="{DynamicResource Cr.ControlDarkBrush}" BorderThickness="{Binding SeparatorThickness}" Padding="0,2,0,0">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" Width="24" Height="24" />
                <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </Setter>
      </ControlTheme>

      <!-- List of values with a check box in front of each (the Check tab of the list selector): the items are drawn by the cr-check-list style of CrControls.axaml. -->
      <ControlTheme x:Key="CrCheckList.Original" TargetType="c:CrCheckList" BasedOn="{StaticResource {x:Type ListBox}}" />

      <!-- Column header -->
      <ControlTheme x:Key="CrHeader.Original" TargetType="c:CrHeader" />

      <!-- Group box: the header is drawn by the control (24 high); the content sits below it and is hidden while collapsed. -->
      <ControlTheme x:Key="CrCollapsibleGroup.Original" TargetType="c:CrCollapsibleGroup">
        <Setter Property="Foreground" Value="{DynamicResource Cr.ControlTextBrush}" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter"
                              Margin="0,24,0,0"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              IsVisible="{TemplateBinding IsExpanded}" />
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <!-- Side panel with a grip -->
      <ControlTheme x:Key="CrSizableContainer.Original" TargetType="c:CrSizableContainer" />

      <!-- Pictures of the original -->
      <ControlTheme x:Key="CrIcon.Original" TargetType="c:CrIcon" />

      <!-- Item views: the thumbnail item and its cover draw themselves from the Cr tokens and the Cr.Thumb.* colours. -->
      <ControlTheme x:Key="CrThumbnailItem.Original" TargetType="c:CrThumbnailItem" />
      <ControlTheme x:Key="CoverView.Original" TargetType="c:CoverView" />
      <ControlTheme x:Key="CrBookToolTip.Original" TargetType="c:CrBookToolTip" />
      <ControlTheme x:Key="CrBookTile.Original" TargetType="c:CrBookTile" />

      <!-- The list of pages of a book (the pages view of the Info dialog): draws itself (CrPageList.Render) from the item view tokens; the scroll bars are the stock ones. -->
      <ControlTheme x:Key="CrPageList.Original" TargetType="c:CrPageList" />

      <!-- The page viewer of the Colors tab: draws itself (CrPageViewer.Render). -->
      <ControlTheme x:Key="CrPageViewer.Original" TargetType="c:CrPageViewer" />
      <ControlTheme x:Key="CrSelectionRectangle.Original" TargetType="c:CrSelectionRectangle" />

      <!-- Reader overlays: they draw the glass pictures and the text themselves (CrTextOverlay, CrPartOverlay, CrNavigationOverlay). -->
      <ControlTheme x:Key="CrReaderPage.Original" TargetType="c:CrReaderPage" />
      <ControlTheme x:Key="CrTextOverlay.Original" TargetType="c:CrTextOverlay" />
      <ControlTheme x:Key="CrPartOverlay.Original" TargetType="c:CrPartOverlay" />
      <ControlTheme x:Key="CrNavigationOverlay.Original" TargetType="c:CrNavigationOverlay" />

      <!-- Dialog window: the base window theme (the dialog draws its surface from the Cr.Control token itself). -->
      <ControlTheme x:Key="CrDialogWindow.Original" TargetType="c:CrDialogWindow" BasedOn="{StaticResource {x:Type Window}}" />

      <!-- Native variants (RV5b). The self-drawn controls draw from ChromePaint, which reads the Native palette (Themes/ChromeNativePalette.cs: the stock theme's own
           brushes for the Cr tokens, flat instead of gradients) and the shapes the control itself branches on (rounded hot rectangles, template tinted icons);
           so most Native themes only have to exist and wear the Original theme (the templates, sizes and bindings stay). What a theme can set it sets here. -->
      <ControlTheme x:Key="CrToolBar.Native" TargetType="c:CrToolBar" BasedOn="{StaticResource CrToolBar.Original}" />
      <ControlTheme x:Key="CrToolSeparator.Native" TargetType="c:CrToolSeparator" BasedOn="{StaticResource CrToolSeparator.Original}" />
      <ControlTheme x:Key="CrSearchBox.Native" TargetType="c:CrSearchBox" BasedOn="{StaticResource CrSearchBox.Original}" />
      <ControlTheme x:Key="CrToolButton.Native" TargetType="c:CrToolButton" BasedOn="{StaticResource CrToolButton.Original}" />
      <ControlTheme x:Key="CrSplitButton.Native" TargetType="c:CrSplitButton" BasedOn="{StaticResource CrSplitButton.Original}" />
      <ControlTheme x:Key="CrDropDownButton.Native" TargetType="c:CrDropDownButton" BasedOn="{StaticResource CrDropDownButton.Original}" />
      <ControlTheme x:Key="CrTabBar.Native" TargetType="c:CrTabBar" BasedOn="{StaticResource CrTabBar.Original}" />
      <ControlTheme x:Key="CrTreeView.Native" TargetType="c:CrTreeView" BasedOn="{StaticResource CrTreeView.Original}" />
      <ControlTheme x:Key="StyledSelectionVisual.Native" TargetType="c:StyledSelectionVisual" BasedOn="{StaticResource StyledSelectionVisual.Original}" />
      <ControlTheme x:Key="CrTreeRow.Native" TargetType="c:CrTreeRow" BasedOn="{StaticResource CrTreeRow.Original}" />
      <ControlTheme x:Key="CrGaugeStrip.Native" TargetType="c:CrGaugeStrip" BasedOn="{StaticResource CrGaugeStrip.Original}" />
      <ControlTheme x:Key="CrRatingStars.Native" TargetType="c:CrRatingStars" BasedOn="{StaticResource CrRatingStars.Original}" />
      <ControlTheme x:Key="CrSpinButton.Native" TargetType="c:CrSpinButton" BasedOn="{StaticResource CrSpinButton.Original}" />
      <ControlTheme x:Key="CrCheckList.Native" TargetType="c:CrCheckList" BasedOn="{StaticResource CrCheckList.Original}" />
      <ControlTheme x:Key="CrHeader.Native" TargetType="c:CrHeader" BasedOn="{StaticResource CrHeader.Original}" />
      <ControlTheme x:Key="CrCollapsibleGroup.Native" TargetType="c:CrCollapsibleGroup" BasedOn="{StaticResource CrCollapsibleGroup.Original}" />
      <ControlTheme x:Key="CrSizableContainer.Native" TargetType="c:CrSizableContainer" BasedOn="{StaticResource CrSizableContainer.Original}" />
      <ControlTheme x:Key="CrIcon.Native" TargetType="c:CrIcon" BasedOn="{StaticResource CrIcon.Original}" />
      <ControlTheme x:Key="CrThumbnailItem.Native" TargetType="c:CrThumbnailItem" BasedOn="{StaticResource CrThumbnailItem.Original}" />
      <ControlTheme x:Key="CoverView.Native" TargetType="c:CoverView" BasedOn="{StaticResource CoverView.Original}" />
      <ControlTheme x:Key="CrBookToolTip.Native" TargetType="c:CrBookToolTip" BasedOn="{StaticResource CrBookToolTip.Original}" />
      <ControlTheme x:Key="CrBookTile.Native" TargetType="c:CrBookTile" BasedOn="{StaticResource CrBookTile.Original}" />
      <ControlTheme x:Key="CrPageList.Native" TargetType="c:CrPageList" BasedOn="{StaticResource CrPageList.Original}" />
      <ControlTheme x:Key="CrPageViewer.Native" TargetType="c:CrPageViewer" BasedOn="{StaticResource CrPageViewer.Original}" />
      <ControlTheme x:Key="CrSelectionRectangle.Native" TargetType="c:CrSelectionRectangle" BasedOn="{StaticResource CrSelectionRectangle.Original}" />
      <ControlTheme x:Key="CrReaderPage.Native" TargetType="c:CrReaderPage" BasedOn="{StaticResource CrReaderPage.Original}" />
      <ControlTheme x:Key="CrTextOverlay.Native" TargetType="c:CrTextOverlay" BasedOn="{StaticResource CrTextOverlay.Original}" />
      <ControlTheme x:Key="CrPartOverlay.Native" TargetType="c:CrPartOverlay" BasedOn="{StaticResource CrPartOverlay.Original}" />
      <ControlTheme x:Key="CrNavigationOverlay.Native" TargetType="c:CrNavigationOverlay" BasedOn="{StaticResource CrNavigationOverlay.Original}" />
      <ControlTheme x:Key="CrDialogWindow.Native" TargetType="c:CrDialogWindow" BasedOn="{StaticResource CrDialogWindow.Original}" />

      <!-- The editors' combo boxes: the separator line above an entry in the stock theme's line colour. -->
      <ControlTheme x:Key="CrValueComboBox.Native" TargetType="c:CrValueComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="ItemTemplate">
          <DataTemplate x:DataType="c:ValueItem">
            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="{Binding SeparatorThickness}" Padding="0,2,0,0">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" Width="24" Height="24" />
                <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </Setter>
      </ControlTheme>

    </ResourceDictionary>
  </Styles.Resources>
</Styles>
