  <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedDisabled" Color="{DynamicResource Cr.ControlDark}" />
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedDisabled" Color="{DynamicResource Cr.GrayText}" />
  <SolidColorBrush x:Key="CheckBoxForegroundCheckedDisabled" Color="{DynamicResource Cr.GrayText}" />
  <SolidColorBrush x:Key="CheckBoxBackgroundCheckedDisabled" Color="Transparent" />
