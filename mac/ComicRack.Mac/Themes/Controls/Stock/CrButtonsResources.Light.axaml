  <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="{DynamicResource Cr.ButtonPressedBorder}" />
  <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="{DynamicResource Cr.ControlDark}" />
  <SolidColorBrush x:Key="ToggleButtonForeground" Color="{DynamicResource Cr.ControlText}" />
  <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="{DynamicResource Cr.ControlText}" />
  <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="{DynamicResource Cr.ControlText}" />
  <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="{DynamicResource Cr.GrayText}" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{DynamicResource Cr.ButtonPressedBack}" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{DynamicResource Cr.ButtonHoverBack}" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{DynamicResource Cr.ButtonPressedBack}" />
