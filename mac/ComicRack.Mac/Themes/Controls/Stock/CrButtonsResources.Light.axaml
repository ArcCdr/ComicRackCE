<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The lightweight styling keys of the Fluent themes for buttons, accent buttons, toggle buttons, check boxes and radio buttons, each a brush whose colour is a Cr token of this appearance
       (Light theme). Part of the Original look of the Buttons element: ChromeVariants adds the pack (CrButtons.Original.axaml) to the application
       styles for Original and removes it for Native, which leaves the stock theme's own brushes (chrome-guidelines section 10). -->
  <SolidColorBrush x:Key="ButtonBackground" Color="{DynamicResource Cr.ButtonBack}" />
  <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{DynamicResource Cr.ButtonHoverBack}" />
  <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{DynamicResource Cr.ButtonPressedBack}" />
  <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{DynamicResource Cr.Control}" />
  <SolidColorBrush x:Key="ButtonBorderBrush" Color="{DynamicResource Cr.ButtonBorder}" />
  <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{DynamicResource Cr.ButtonHoverBorder}" />
  <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{DynamicResource Cr.ButtonPressedBorder}" />
  <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{DynamicResource Cr.ControlDark}" />
  <SolidColorBrush x:Key="ButtonForeground" Color="{DynamicResource Cr.ControlText}" />
  <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{DynamicResource Cr.ControlText}" />
  <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{DynamicResource Cr.ControlText}" />
  <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{DynamicResource Cr.GrayText}" />
  <SolidColorBrush x:Key="AccentButtonBackground" Color="{DynamicResource Cr.ButtonBack}" />
  <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{DynamicResource Cr.ButtonHoverBack}" />
  <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{DynamicResource Cr.ButtonPressedBack}" />
  <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="{DynamicResource Cr.Control}" />
  <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="{DynamicResource Cr.ButtonDefaultBorder}" />
  <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="{DynamicResource Cr.ButtonHoverBorder}" />
  <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="{DynamicResource Cr.ButtonPressedBorder}" />
  <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="{DynamicResource Cr.ControlDark}" />
  <SolidColorBrush x:Key="AccentButtonForeground" Color="{DynamicResource Cr.ControlText}" />
  <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{DynamicResource Cr.ControlText}" />
  <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{DynamicResource Cr.ControlText}" />
  <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="{DynamicResource Cr.GrayText}" />
  <SolidColorBrush x:Key="ToggleButtonBackground" Color="{DynamicResource Cr.ButtonBack}" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{DynamicResource Cr.ButtonHoverBack}" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="{DynamicResource Cr.ButtonPressedBack}" />
