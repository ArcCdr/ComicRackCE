<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ComicRack.Mac.Controls"
        xmlns:conv="clr-namespace:Avalonia.Controls.Converters;assembly=Avalonia.Controls">
  <!-- The Native look of the ComboBox element: the stock Fluent combo box with the system font size 13 and a 5 unit corner radius. -->
  <Style Selector="ComboBox">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="FontSize" Value="13" />
  </Style>
</Styles>
