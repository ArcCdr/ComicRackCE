<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ComicRack.Mac.Controls"
        xmlns:conv="clr-namespace:Avalonia.Controls.Converters;assembly=Avalonia.Controls">
  <!-- The Native look of the Menus element: the stock Fluent menus (their own colours) with the system font size 13 and rounded corners. -->
  <Style Selector="MenuItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="ContextMenu">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
</Styles>
