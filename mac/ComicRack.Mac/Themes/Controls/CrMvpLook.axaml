<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The look of the MVP surfaces that the restyle tasks have not reached yet (the reader window and the performance overlay: P5.R3; the grid
       cells were restyled by P5.R2 and live in CrThumbnailLook.axaml). The values were literals in the views; they are here unchanged so that the
       views carry none and the restyle of each surface is a change of this file. A restyle task replaces the entries of its surface with Cr tokens
       and deletes them here. -->
  <Styles.Resources>
    <ResourceDictionary>
      <!-- reader window and its paper -->
      <SolidColorBrush x:Key="Cr.Mvp.ReaderPaperBrush" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Cr.Mvp.ReaderStatusBackBrush" Color="#262626" />
      <SolidColorBrush x:Key="Cr.Mvp.ReaderStatusTitleBrush" Color="#B0B0B0" />
      <SolidColorBrush x:Key="Cr.Mvp.ReaderStatusDimBrush" Color="#909090" />
      <SolidColorBrush x:Key="Cr.Mvp.ReaderStatusPageBrush" Color="#E0E0E0" />
      <SolidColorBrush x:Key="Cr.Mvp.ReaderNoticeBackBrush" Color="#CC000000" />
      <SolidColorBrush x:Key="Cr.Mvp.ReaderNoticeTextBrush" Color="#F0F0F0" />
      <!-- performance overlay -->
      <SolidColorBrush x:Key="Cr.Mvp.OverlayBackBrush" Color="#E0101010" />
      <SolidColorBrush x:Key="Cr.Mvp.OverlayTextBrush" Color="#E8F4E8" />
      <FontFamily x:Key="Cr.Mvp.OverlayFontFamily">Menlo, Monaco, Courier New, monospace</FontFamily>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Reader window (MVP): a dark window whatever the appearance, a status strip, a notice box over the page. -->
  <Style Selector="Window.cr-reader">
    <Setter Property="Background" Value="{DynamicResource Cr.Mvp.ReaderPaperBrush}" />
    <Setter Property="RequestedThemeVariant" Value="Dark" />
  </Style>
  <Style Selector="Border.cr-reader-status">
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="Background" Value="{DynamicResource Cr.Mvp.ReaderStatusBackBrush}" />
  </Style>
  <Style Selector="TextBlock.cr-reader-status-title">
    <Setter Property="Foreground" Value="{DynamicResource Cr.Mvp.ReaderStatusTitleBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.cr-reader-status-dim">
    <Setter Property="Foreground" Value="{DynamicResource Cr.Mvp.ReaderStatusDimBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.cr-reader-status-page">
    <Setter Property="Foreground" Value="{DynamicResource Cr.Mvp.ReaderStatusPageBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.cr-reader-notice">
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource Cr.Mvp.ReaderNoticeBackBrush}" />
  </Style>
  <Style Selector="TextBlock.cr-reader-notice-text">
    <Setter Property="Foreground" Value="{DynamicResource Cr.Mvp.ReaderNoticeTextBrush}" />
  </Style>

  <!-- Performance overlay (MVP): a translucent block with monospaced text. -->
  <Style Selector=":is(Border).cr-overlay">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource Cr.Mvp.OverlayBackBrush}" />
  </Style>
  <Style Selector="TextBlock.cr-overlay-text">
    <Setter Property="FontFamily" Value="{DynamicResource Cr.Mvp.OverlayFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Cr.Mvp.OverlayTextBrush}" />
  </Style>
</Styles>
