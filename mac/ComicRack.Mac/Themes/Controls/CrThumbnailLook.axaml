<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The colours that ComicRack's thumbnail renderers write as literals (ThumbRenderer, RatingRenderer, ThumbIconRenderer in ComicRack.Engine/Drawing),
       read by CrThumbnailItem through ChromePaint.ResourceBrush. They do not change with the appearance in the original either: the shadow, the frame
       and the ribbon outlines are black, an unloaded cover is white, the badge is black with alpha 192. The colour of the caption and of the selection
       comes from the Cr tokens, not from here. -->
  <Styles.Resources>
    <ResourceDictionary>
      <!-- ThumbRenderer.DrawShadow: Color.Black at opacity 0.33 (255 * 0.33 = 84) -->
      <SolidColorBrush x:Key="Cr.Thumb.ShadowBrush" Color="#54000000" />
      <!-- ThumbRenderer.DrawThumbnail: graphics.DrawRectangle(Pens.Black, ...) -->
      <SolidColorBrush x:Key="Cr.Thumb.BorderBrush" Color="#FF000000" />
      <!-- ThumbRenderer.MissingBackColor = Color.White; DrawMissingThumbnail text Brushes.LightGray -->
      <SolidColorBrush x:Key="Cr.Thumb.MissingBackBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="Cr.Thumb.MissingTextBrush" Color="#FFD3D3D3" />
      <!-- ThumbRenderer.DrawPageNumber: fill Color.FromArgb(192, Black), text White, frame Pens.Black -->
      <SolidColorBrush x:Key="Cr.Thumb.BadgeBackBrush" Color="#C0000000" />
      <SolidColorBrush x:Key="Cr.Thumb.BadgeTextBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="Cr.Thumb.BadgeFrameBrush" Color="#FF000000" />
      <!-- ThumbRenderer.DefaultBookmarkColors: Orange, Green, Red, Blue; the ribbon fades to half of each channel; shadow and outline are black -->
      <SolidColorBrush x:Key="Cr.Thumb.Bookmark0Brush" Color="#FFFFA500" />
      <SolidColorBrush x:Key="Cr.Thumb.Bookmark1Brush" Color="#FF008000" />
      <SolidColorBrush x:Key="Cr.Thumb.Bookmark2Brush" Color="#FFFF0000" />
      <SolidColorBrush x:Key="Cr.Thumb.Bookmark3Brush" Color="#FF0000FF" />
      <SolidColorBrush x:Key="Cr.Thumb.BookmarkShadowBrush" Color="#FF000000" />
      <SolidColorBrush x:Key="Cr.Thumb.BookmarkFrameBrush" Color="#FF000000" />
      <!-- RatingRenderer.RatingTextColor = Color.DimGray (the number on the rating tags) -->
      <SolidColorBrush x:Key="Cr.Thumb.RatingTextBrush" Color="#FF696969" />
      <!-- The paper of the grid behind the cells: ThemeColors.ItemView.MainBack (itemView.BackColor in ComicBrowserControl.Designer.cs) -->
      <!-- The tile that stands for a thumbnail that cannot be made (a Mac addition: the original draws a missing cover as a white tile with LightGray text).
           The decoder draws it on a worker thread from ThumbnailPlaceholderLook, which reads these entries for the current appearance. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Cr.Thumb.PlaceholderTileBrush" Color="#FFDCDCDC" />
          <SolidColorBrush x:Key="Cr.Thumb.PlaceholderFrameBrush" Color="#FFA8A8A8" />
          <SolidColorBrush x:Key="Cr.Thumb.PlaceholderCrossBrush" Color="#FF9C9C9C" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Cr.Thumb.PlaceholderTileBrush" Color="#FF3A3A3A" />
          <SolidColorBrush x:Key="Cr.Thumb.PlaceholderFrameBrush" Color="#FF5A5A5A" />
          <SolidColorBrush x:Key="Cr.Thumb.PlaceholderCrossBrush" Color="#FF6A6A6A" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
</Styles>
