<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Generated once, then maintained by hand. The lightweight styling keys of the Fluent control themes (button, toggle button, check box, radio
       button, text box, combo box, slider, tab, tool tip, popup menu), each a brush whose colour is a Cr token of this variant, so that the
       base control themes draw with the original's colours (chrome-guidelines 2.1, 2.5; decision C-CTRL-1). Light theme.
       Edit surfaces: the Window colour. -->
  <SolidColorBrush x:Key="ButtonBackground" Color="{DynamicResource Cr.ButtonBack}" />
  <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{DynamicResource Cr.ButtonHoverBack}" />
  <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{DynamicResource Cr.ButtonPressedBack}" />
  <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{DynamicResource Cr.Control}" />
  <SolidColorBrush x:Key="ButtonBorderBrush" Color="{DynamicResource Cr.ButtonBorder}" />
  <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{DynamicResource Cr.ButtonHoverBorder}" />
  <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{DynamicResource Cr.ButtonPressedBorder}" />
  <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{DynamicResource Cr.ControlDark}" />
  <SolidColorBrush x:Key="ButtonForeground" Color="{DynamicResource Cr.ControlText}" />
  <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{DynamicResource Cr.ControlText}" />
  <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{DynamicResource Cr.ControlText}" />
  <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{DynamicResource Cr.GrayText}" />
  <SolidColorBrush x:Key="AccentButtonBackground" Color="{DynamicResource Cr.ButtonBack}" />
  <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{DynamicResource Cr.ButtonHoverBack}" />
