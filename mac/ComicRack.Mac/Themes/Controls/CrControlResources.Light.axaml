<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Generated once, then maintained by hand. The lightweight styling keys of the Fluent control themes (text box, slider, tab, tool tip: the keys that no chrome element owns;
       buttons, combo boxes and popup menus are in Stock/), each a brush whose colour is a Cr token of this variant, so that the
       base control themes draw with the original's colours (chrome-guidelines 2.1, 2.5; decision C-CTRL-1). Light theme.
       Edit surfaces: the Window colour. -->
  <SolidColorBrush x:Key="TextControlBackground" Color="{DynamicResource Cr.Window}" />
  <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{DynamicResource Cr.Window}" />
  <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{DynamicResource Cr.Window}" />
  <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{DynamicResource Cr.Control}" />
  <SolidColorBrush x:Key="TextControlBorderBrush" Color="{DynamicResource Cr.EditFrame}" />
  <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{DynamicResource Cr.EditHoverFrame}" />
  <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{DynamicResource Cr.EditFocusFrame}" />
  <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="{DynamicResource Cr.ControlDark}" />
  <SolidColorBrush x:Key="TextControlForeground" Color="{DynamicResource Cr.ControlText}" />
  <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{DynamicResource Cr.ControlText}" />
  <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{DynamicResource Cr.ControlText}" />
  <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{DynamicResource Cr.GrayText}" />
  <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{DynamicResource Cr.GrayText}" />
  <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{DynamicResource Cr.GrayText}" />
  <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{DynamicResource Cr.GrayText}" />
  <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="{DynamicResource Cr.GrayText}" />
  <SolidColorBrush x:Key="TextControlButtonBackground" Color="Transparent" />
  <SolidColorBrush x:Key="TextControlButtonBackgroundPointerOver" Color="{DynamicResource Cr.ButtonHoverBack}" />
  <SolidColorBrush x:Key="TextControlButtonBackgroundPressed" Color="{DynamicResource Cr.ButtonPressedBack}" />
  <SolidColorBrush x:Key="TextControlButtonBorderBrush" Color="Transparent" />
  <SolidColorBrush x:Key="TextControlButtonBorderBrushPointerOver" Color="Transparent" />
  <SolidColorBrush x:Key="TextControlButtonBorderBrushPressed" Color="Transparent" />
  <SolidColorBrush x:Key="TextControlButtonForeground" Color="{DynamicResource Cr.ControlText}" />
  <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="{DynamicResource Cr.ControlText}" />
  <SolidColorBrush x:Key="TextControlButtonForegroundPressed" Color="{DynamicResource Cr.ControlText}" />
  <SolidColorBrush x:Key="SliderTrackFill" Color="{DynamicResource Cr.TrackBarTrack}" />
  <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="{DynamicResource Cr.TrackBarTrack}" />
  <SolidColorBrush x:Key="SliderTrackFillPressed" Color="{DynamicResource Cr.TrackBarTrack}" />
  <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="{DynamicResource Cr.Control}" />
  <SolidColorBrush x:Key="SliderTrackValueFill" Color="{DynamicResource Cr.TrackBarTrack}" />
  <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{DynamicResource Cr.TrackBarTrack}" />
  <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{DynamicResource Cr.TrackBarTrack}" />
  <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="{DynamicResource Cr.Control}" />
  <SolidColorBrush x:Key="SliderThumbBackground" Color="{DynamicResource Cr.TrackBarThumb}" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{DynamicResource Cr.Highlight}" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{DynamicResource Cr.ButtonPressedBorder}" />
  <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="{DynamicResource Cr.ControlDark}" />
  <SolidColorBrush x:Key="SliderContainerBackground" Color="Transparent" />
  <SolidColorBrush x:Key="SliderContainerBackgroundPointerOver" Color="Transparent" />
  <SolidColorBrush x:Key="SliderContainerBackgroundPressed" Color="Transparent" />
  <SolidColorBrush x:Key="SliderContainerBackgroundDisabled" Color="Transparent" />
  <SolidColorBrush x:Key="SliderTickBarFill" Color="{DynamicResource Cr.ControlDark}" />
  <SolidColorBrush x:Key="SliderTickBarFillDisabled" Color="{DynamicResource Cr.ControlDark}" />
  <SolidColorBrush x:Key="SliderInlineTickBarFill" Color="{DynamicResource Cr.ControlDark}" />
  <SolidColorBrush x:Key="TabItemHeaderBackgroundSelected" Color="{DynamicResource Cr.TabPageSelected}" />
  <SolidColorBrush x:Key="TabItemHeaderBackgroundSelectedPointerOver" Color="{DynamicResource Cr.TabPageSelected}" />
  <SolidColorBrush x:Key="TabItemHeaderBackgroundSelectedPressed" Color="{DynamicResource Cr.TabPageSelected}" />
  <SolidColorBrush x:Key="TabItemHeaderBackgroundUnselected" Color="{DynamicResource Cr.TabPageOther}" />
  <SolidColorBrush x:Key="TabItemHeaderBackgroundUnselectedPointerOver" Color="{DynamicResource Cr.ButtonHoverBack}" />
  <SolidColorBrush x:Key="TabItemHeaderBackgroundUnselectedPressed" Color="{DynamicResource Cr.ButtonPressedBack}" />
  <SolidColorBrush x:Key="TabItemHeaderBackgroundDisabled" Color="{DynamicResource Cr.Control}" />
  <SolidColorBrush x:Key="TabItemHeaderForegroundSelected" Color="{DynamicResource Cr.ControlText}" />
  <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPointerOver" Color="{DynamicResource Cr.ControlText}" />
  <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPressed" Color="{DynamicResource Cr.ControlText}" />
  <SolidColorBrush x:Key="TabItemHeaderForegroundUnselected" Color="{DynamicResource Cr.ControlText}" />
  <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPointerOver" Color="{DynamicResource Cr.ControlText}" />
  <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPressed" Color="{DynamicResource Cr.ControlText}" />
  <SolidColorBrush x:Key="TabItemHeaderForegroundDisabled" Color="{DynamicResource Cr.GrayText}" />
  <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="Transparent" />
  <SolidColorBrush x:Key="TabControlBackground" Color="{DynamicResource Cr.TabPageSelected}" />
  <SolidColorBrush x:Key="ToolTipBackground" Color="{DynamicResource Cr.Info}" />
  <SolidColorBrush x:Key="ToolTipForeground" Color="{DynamicResource Cr.InfoText}" />
  <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{DynamicResource Cr.WindowFrame}" />
</ResourceDictionary>
