  <SolidColorBrush x:Key="MenuFlyoutItemBackgroundDisabled" Color="{DynamicResource Cr.Menu}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="{DynamicResource Cr.MenuText}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="{DynamicResource Cr.HighlightText}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="{DynamicResource Cr.HighlightText}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="{DynamicResource Cr.GrayText}" />
  <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="{DynamicResource Cr.GrayText}" />
  <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver" Color="{DynamicResource Cr.HighlightText}" />
  <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPressed" Color="{DynamicResource Cr.HighlightText}" />
  <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundDisabled" Color="{DynamicResource Cr.GrayText}" />
</ResourceDictionary>
