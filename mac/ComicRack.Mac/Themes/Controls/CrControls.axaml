<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ComicRack.Mac.Controls">
  <!-- Styles that bring the base control themes to the original's look and metrics (C-CTRL-1, C-SCROLL-1, C-FOCUS-1) for the controls that no chrome element
       owns. The colours come from the Cr control resources (CrControlResources.*.axaml) through the base themes' own keys; what is set here is shape and size.
       Added after the base theme, so these win. -->

  <!-- Buttons, check boxes and radio buttons, combo boxes and popup menus are the Original packs of the Buttons, ComboBox and Menus elements (Stock/Cr*.Original.axaml),
       added and removed by ChromeVariants. What stays here is shared by both variants. -->
  <Style Selector="TextBox">
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Selection in list boxes: the system highlight, as the native list box. -->
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Cr.HighlightBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Cr.HighlightTextBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Cr.HighlightBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Cr.HighlightTextBrush}" />
  </Style>
  <Style Selector="ListBoxItem:pointerover:not(:selected) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Cr.ButtonHoverBackBrush}" />
  </Style>

  <!-- Scroll bars (C-SCROLL-1): the base theme's thin bars that grow on hover and fade; App.axaml.cs sets AllowAutoHide from the system setting. -->

  <!-- Tab control: the Windows 10 tab look, a one unit frame around the page and the tabs. -->
  <Style Selector="TabControl">
    <Setter Property="BorderBrush" Value="{DynamicResource Cr.TabPageBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TabItem">
    <Setter Property="BorderBrush" Value="{DynamicResource Cr.TabPageBorderBrush}" />
    <Setter Property="BorderThickness" Value="1,1,1,0" />
    <Setter Property="Padding" Value="6,0,6,0" />
  </Style>

  <!-- The Check view of the list selector (CrCheckList): a list whose items have a check box; the checked items are the selected ones. -->
  <Style Selector="ListBox.cr-check-list ListBoxItem">
    <Setter Property="Padding" Value="2,1" />
    <Setter Property="Template">
      <ControlTemplate>
        <CheckBox Padding="{TemplateBinding Padding}" IsChecked="{TemplateBinding IsSelected, Mode=TwoWay}" Content="{TemplateBinding Content}" />
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- Keyboard focus (C-FOCUS-1): the system accent ring around the control instead of the dotted rectangle. -->
  <Style Selector=":is(Control)">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderThickness="3"
                CornerRadius="4"
                Margin="-3"
                IsHitTestVisible="False"
                Opacity="0.6"
                BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
</Styles>
