<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ComicRack.Mac.Controls">
  <!-- Styles that bring the base control themes to the original's look and metrics (C-CTRL-1, C-MENU-3, C-SCROLL-1, C-FOCUS-1). The colours come from the
       Cr control resources (CrControlResources.*.axaml) through the base themes' own keys; what is set here is shape and size. Added after the base
       theme, so these win. -->

  <!-- Buttons: square, 23 high, the Windows 10 look. -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="MinHeight" Value="23" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="MinHeight" Value="23" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Cr.GrayTextBrush}" />
  </Style>
  <Style Selector="Button[IsDefault=true]:not(:pointerover):not(:pressed) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Cr.ButtonDefaultBorderBrush}" />
  </Style>

  <!-- Selection in list boxes: the system highlight, as the native list box. -->
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Cr.HighlightBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Cr.HighlightTextBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Cr.HighlightBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Cr.HighlightTextBrush}" />
  </Style>
  <Style Selector="ListBoxItem:pointerover:not(:selected) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Cr.ButtonHoverBackBrush}" />
  </Style>

  <!-- Popup menus (C-MENU-3): system font 13, rounded, the system accent as the selection; the items and their order are the original's. -->
  <Style Selector="MenuItem">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="ContextMenu">
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Scroll bars (C-SCROLL-1): the base theme's thin bars that grow on hover and fade; App.axaml.cs sets AllowAutoHide from the system setting. -->

  <!-- Tab control: the Windows 10 tab look, a one unit frame around the page and the tabs. -->
  <Style Selector="TabControl">
    <Setter Property="BorderBrush" Value="{DynamicResource Cr.TabPageBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TabItem">
    <Setter Property="BorderBrush" Value="{DynamicResource Cr.TabPageBorderBrush}" />
    <Setter Property="BorderThickness" Value="1,1,1,0" />
    <Setter Property="Padding" Value="6,0,6,0" />
  </Style>

  <!-- Keyboard focus (C-FOCUS-1): the system accent ring around the control instead of the dotted rectangle. -->
  <Style Selector=":is(Control)">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderThickness="3"
                CornerRadius="4"
                Margin="-3"
                IsHitTestVisible="False"
                Opacity="0.6"
                BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
</Styles>
