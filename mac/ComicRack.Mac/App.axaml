<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ComicRack.Mac.App"
             Name="ComicRack CE (MVP)"
             RequestedThemeVariant="Default">
  <!-- Default = follow the system light/dark setting. -->
  <!-- C-APP-1: the Cr.* tokens of the original (Default theme = Light, Dark theme = Dark) follow the macOS appearance; the theme option (light or dark) forces one.
       Fluent is still the base control theme; the Cr control resources (CrControlResources.*) and styles (CrControls) override its colours,
       shapes and sizes where the original has its own look (P5.T4). -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ComicRack.Mac/Themes/Controls/CrMetrics.axaml" />
        <ResourceInclude Source="avares://ComicRack.Mac/Themes/Controls/CrControlThemes.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="avares://ComicRack.Mac/Themes/ComicRackTheme.Light.axaml" />
            <ResourceInclude Source="avares://ComicRack.Mac/Themes/Controls/CrControlResources.Light.axaml" />
          </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="avares://ComicRack.Mac/Themes/ComicRackTheme.Dark.axaml" />
            <ResourceInclude Source="avares://ComicRack.Mac/Themes/Controls/CrControlResources.Dark.axaml" />
          </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://ComicRack.Mac/Themes/Controls/CrChromeThemes.axaml" />
    <StyleInclude Source="avares://ComicRack.Mac/Themes/Controls/CrControls.axaml" />
    <StyleInclude Source="avares://ComicRack.Mac/Themes/Controls/CrParts.axaml" />
    <StyleInclude Source="avares://ComicRack.Mac/Themes/Controls/CrMvpLook.axaml" />
  </Application.Styles>
</Application>
