<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ComicRack.Mac.App"
             RequestedThemeVariant="Default">
  <!-- Default = follow the system light/dark setting. -->
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
</Application>
