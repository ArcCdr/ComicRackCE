<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ComicRack.Mac.ViewModels"
        xmlns:views="using:ComicRack.Mac.Views"
        x:Class="ComicRack.Mac.Views.ReaderWindow"
        x:DataType="vm:ReaderViewModel"
        Title="{Binding Title}"
        Width="900" Height="1000" MinWidth="360" MinHeight="300"
        Classes="cr-reader"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <!-- Page number, layout, direction, zoom and fit mode. Hidden in full screen. -->
    <Border Name="StatusStrip" Classes="cr-reader-status" DockPanel.Dock="Bottom" IsVisible="{Binding ShowStatus}">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="16">
        <TextBlock Name="TitleLabel" Classes="cr-reader-status-title" Grid.Column="0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
        <TextBlock Name="ModeLabel" Classes="cr-reader-status-dim" Grid.Column="1" Text="{Binding ModeText}" />
        <TextBlock Name="FitLabel" Classes="cr-reader-status-dim" Grid.Column="2" Text="{Binding FitText}" />
        <TextBlock Name="PageLabel" Classes="cr-reader-status-page" Grid.Column="3" Text="{Binding PageText}" />
      </Grid>
    </Border>
    <Grid Name="ContentArea">
      <views:ReaderView Name="PageView" />
      <!-- Opening, Loading page N, or why a page could not be shown. -->
      <Border Name="NoticeBox" Classes="cr-reader-notice" IsVisible="{Binding HasNotice}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
        <TextBlock Name="NoticeLabel" Classes="cr-reader-notice-text" Text="{Binding Notice}" TextWrapping="Wrap" TextAlignment="Center" />
      </Border>
    </Grid>
  </DockPanel>
</Window>
