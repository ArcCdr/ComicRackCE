<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:ComicRack.Mac.Views"
        x:Class="ComicRack.Mac.Views.ReaderWindow"
        Title="ComicRack"
        Width="900" Height="1000" MinWidth="360" MinHeight="300"
        Classes="cr-window"
        WindowStartupLocation="CenterScreen">
  <!-- The reader in its own window (Display > Reader in own Window, F12; ReaderForm of the original): the reader area only. The tab strip with the reader toolbar,
       the status bar and the browser stay in the main window. The title is the caption of the book (readerForm.Text = tsBook.Text). -->
  <views:ReaderArea Name="Pane" />
</Window>
