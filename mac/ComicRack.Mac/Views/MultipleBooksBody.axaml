             x:Class="ComicRack.Mac.Views.MultipleBooksBody">
  <!-- Generated from the positions of MultipleComicBooksDialog.Designer.cs (pageData 497 x 407 with a one unit frame; the groups are 478 wide, as they are beside the 17 wide scroll bar).
       Every group is a CrCollapsibleGroup (24 high header) over a Panel whose controls are placed at the Designer's position minus the header: a margin is the position. In front of every
       box is the check box that MakeCheckBox adds (16 x 17, centred on the box, the box 18 to the right and 18 narrower); the labels stay where they are, as in the original
       (its lookup of the label finds nothing). A box with a list selector is 16 narrower (ListSelectorControl.Register), a number box 11 narrower with the spin button 1 to the right
       of it (SpinButton.AddUpDown). Texts are the Designer's English texts; the code behind replaces every Tag'd label and group header by the original's translation
       (TR section MultipleComicBooksDialog, key = the Tag). The Custom Fields group is filled from the code. -->
  <Panel Name="host">
  <Border Name="pageDataFrame" Classes="cr-framed-panel">
    <ScrollViewer Name="pageData" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Name="groupStack" Width="478" HorizontalAlignment="Left">
