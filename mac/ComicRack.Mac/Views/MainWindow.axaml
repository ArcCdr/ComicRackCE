<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ComicRack.Mac.ViewModels"
        xmlns:views="using:ComicRack.Mac.Views"
        xmlns:c="clr-namespace:ComicRack.Mac.Controls"
        x:Class="ComicRack.Mac.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Width="1100" Height="720" MinWidth="640" MinHeight="400"
        Classes="cr-window"
        WindowStartupLocation="CenterScreen">
  <!-- The main window as the original's main form (MainForm.Designer.cs, MV.01): the tab strip with the reader toolbar on top, the reader area (or the Quick Open pane
       while no book is open) below it, the browser docked at the bottom (ComicExplorerView.Designer.cs, ComicBrowserControl.Designer.cs: the side panel, 252 wide with a
       6 unit grip, on the left, the browser toolbar, 25 high, above the book list) and the status bar (24 high). The menu is the native menu bar (MainMenu.cs).
       Chrome only through the Cr controls and the cr-* style classes (chrome-architecture.md). -->
  <DockPanel>
    <!-- Status bar (SB.01, SB.04, SB.05): the text of the browser, the segments of the open book, the thumbnail size slider at the right end. -->
    <c:CrStatusBar Name="StatusBar" DockPanel.Dock="Bottom" IsVisible="{Binding ShowChrome}">
      <c:CrStatusSlot Name="SizeSlot" DockPanel.Dock="Right" Width="120" Height="22" Margin="0,1,0,1" Sunken="False" IsVisible="{Binding BrowserDockVisible}">
        <Slider Name="SizeSlider" Width="110" Minimum="80" Maximum="360" Value="{Binding Browser.ThumbnailSize}" VerticalAlignment="Center" />
      </c:CrStatusSlot>
      <TextBlock Name="PageCountSegment" DockPanel.Dock="Right" Text="{Binding PageCountSegmentText}" ToolTip.Tip="{Binding PageCountSegmentTip}" VerticalAlignment="Center" Margin="4,0" />
      <TextBlock Name="PageSegment" DockPanel.Dock="Right" Text="{Binding PageSegmentText}" ToolTip.Tip="{Binding PageSegmentTip}" VerticalAlignment="Center" Margin="4,0" />
      <!-- the padlock of tsCurrentPage while Track current Page is off -->
      <c:CrIcon Name="PageLockIcon" DockPanel.Dock="Right" IconName="Locked" IsVisible="{Binding ShowPageLock}" VerticalAlignment="Center" />
      <TextBlock Name="BookSegment" DockPanel.Dock="Right" Text="{Binding BookSegmentText}" ToolTip.Tip="{Binding BookSegmentTip}" VerticalAlignment="Center" Margin="4,0" />
      <TextBlock Name="StatusLabel" Text="{Binding StatusLine}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0" />
    </c:CrStatusBar>

    <!-- fileTabs with mainToolStrip at its right (MainForm.Designer.cs:2577-2615, TB.01 to TB.09, TC.01): one tab per open book and the New Tab button; the reader
         toolbar works on the book of the current tab. Without a book only Full Screen and Tools stay. -->
    <c:CrTabBar Name="TabBar" DockPanel.Dock="Top" IsVisible="{Binding ShowTabBar}">
      <c:CrTabBar.ToolbarSlot>
        <c:CrToolBar Name="ReaderToolBar" Transparent="True">
          <c:CrSplitButton Name="PreviousPageButton" IconName="GoPrevious" IsVisible="{Binding HasBook}" Command="{Binding Reader.PreviousPageCommand}" />
          <c:CrSplitButton Name="NextPageButton" IconName="GoNext" IsVisible="{Binding HasBook}" Command="{Binding Reader.NextPageCommand}" />
          <c:CrToolSeparator IsVisible="{Binding HasBook}" />
          <c:CrSplitButton Name="PageLayoutButton" IconName="{Binding Reader.LayoutIconName, FallbackValue=SinglePage}" IsVisible="{Binding HasBook}" Command="{Binding Reader.TogglePageLayoutCommand}" />
          <c:CrSplitButton Name="FitButton" IconName="{Binding Reader.FitIconName, FallbackValue=FitAll}" IsVisible="{Binding HasBook}" Command="{Binding Reader.ToggleFitCommand}" />
          <c:CrSplitButton Name="ZoomButton" IconName="ZoomIn" Text="{Binding Reader.ZoomText}" IsVisible="{Binding HasBook}" Command="{Binding Reader.CycleZoomCommand}" />
          <c:CrToolSeparator IsVisible="{Binding HasBook}" />
          <c:CrToolButton Name="FullScreenButton" IconName="FullScreen" IsChecked="{Binding IsFullScreen, Mode=OneWay}" Command="{Binding ToggleFullScreenCommand}" />
          <c:CrToolSeparator />
          <c:CrToolButton Name="ToolsButton" IconName="Tools" />
        </c:CrToolBar>
      </c:CrTabBar.ToolbarSlot>
    </c:CrTabBar>

    <!-- The browser panel docked at the bottom (mainViewContainer, 250 high, grip on top, collapsible; the other docking modes are P5.32b). It fills the window when there
         is no reader area, or while the reader is in its own window. -->
    <c:CrSizableContainer Name="BrowserDock" DockPanel.Dock="Bottom" Grip="Top" Fill="{Binding BrowserFills}"
                          ExpandedExtent="{Binding BrowserDockHeight, Mode=TwoWay}" IsExpanded="{Binding IsBrowserVisible, Mode=TwoWay}"
                          IsVisible="{Binding BrowserDockVisible}">
      <DockPanel>
        <!-- Side panel with the library tree (LT.01). The grip (right) resizes it and the Sidebar button, Browse > Sidebar and Shift+F6 collapse it. -->
        <c:CrSizableContainer Name="SidebarPanel" DockPanel.Dock="Left" Grip="Right"
                              ExpandedExtent="{Binding Sidebar.Width, Mode=TwoWay}" IsExpanded="{Binding Sidebar.IsVisible, Mode=TwoWay}">
          <DockPanel>
            <!-- previewPane (ComicExplorerView.Designer.cs): the small preview under the tree, 207 high with the grip on top and a flat border; closed it keeps its grip (Browse > Small Preview, Shift+F7) -->
            <c:CrSizableContainer Name="PreviewPanel" DockPanel.Dock="Bottom" Grip="Top" FlatBorder="True" KeepGripVisible="True"
                                  ExpandedExtent="{Binding SmallPreview.Extent, Mode=TwoWay}" IsExpanded="{Binding SmallPreview.IsVisible, Mode=TwoWay}">
              <views:SmallPreviewPane Name="PreviewPane" DataContext="{Binding SmallPreview}" />
            </c:CrSizableContainer>
            <Border Classes="cr-panel">
              <c:CrTreeView Name="SidebarTree" ItemsSource="{Binding Sidebar.Roots}" SelectedItem="{Binding Sidebar.SelectedNode, Mode=TwoWay}"
                            IconMember="IconName" TextMember="Name" TotalMember="Count" UnreadMember="UnreadCount" NewMember="NewCount" ToolTipMember="Badge"
                            ChildrenMember="Children" ExpandedMember="IsExpanded"
                            GaugesVisible="{Binding Sidebar.GaugesVisible}" GaugeTotal="{Binding Sidebar.GaugeTotal}" GaugeUnread="{Binding Sidebar.GaugeUnread}"
                            GaugeNew="{Binding Sidebar.GaugeNew}" GaugeNumeric="{Binding Sidebar.GaugeNumeric}" />
            </Border>
          </DockPanel>
        </c:CrSizableContainer>

        <Grid RowDefinitions="Auto,*">
          <!-- Browser toolbar (BT.*), in the original's order (ComicBrowserControl.Designer.cs, toolStrip, HorizontalStackWithOverflow): Sidebar, Previous, Next |
               Views, Group, Stack, Arrange, List Layouts | Duplicate | Undo, Redo, and the quick search at the right end (Alignment Right, Overflow Never). When the
               window is too narrow the last buttons go to the overflow drop-down. A button whose feature is not built yet is there and disabled; its task enables it. -->
          <c:CrToolBar Name="BrowserToolBar" Grid.Row="0">
            <c:CrToolButton Name="SidebarButton" IconName="Sidebar" CheckOnClick="True" IsChecked="{Binding Sidebar.IsVisible, Mode=TwoWay}" />
            <c:CrToolButton Name="BrowsePreviousButton" IconName="BrowsePrevious" IsEnabled="False" />
            <c:CrToolButton Name="BrowseNextButton" IconName="BrowseNext" IsEnabled="False" />
            <c:CrToolSeparator />
            <c:CrSplitButton Name="ViewsButton" IconName="View" IsEnabled="False" />
            <c:CrSplitButton Name="GroupButton" IconName="Group" IsEnabled="False" />
            <c:CrSplitButton Name="StackButton" IconName="Stacking" IsEnabled="False" />
            <c:CrSplitButton Name="ArrangeButton" IconName="{Binding Browser.SortIconName}" Text="{Binding Browser.SortName}" />
            <c:CrDropDownButton Name="ListLayoutsButton" IconName="ListLayout" IsEnabled="False" />
            <c:CrToolSeparator />
            <c:CrDropDownButton Name="DuplicateButton" IconName="AddList" IsEnabled="False" />
            <c:CrToolSeparator />
            <c:CrToolButton Name="UndoButton" IconName="Undo" IsEnabled="False" />
            <c:CrToolButton Name="RedoButton" IconName="Redo" IsEnabled="False" />
            <c:CrSearchBox Name="SearchBox" Text="{Binding Browser.SearchText, Mode=TwoWay}" c:CrToolBar.Alignment="Right" c:CrToolBar.Overflow="Never" />
          </c:CrToolBar>

          <Grid Name="ContentArea" Grid.Row="1">
            <views:BookGridView Name="BookGrid" DataContext="{Binding Browser}" />

            <!-- What an empty list says: scripts needed, no books, or a failure. -->
            <TextBlock Name="ListNotice" Text="{Binding Sidebar.Notice}" IsVisible="{Binding Sidebar.HasNotice}" TextWrapping="Wrap"
                       MaxWidth="480" TextAlignment="Center" Classes="cr-hint" VerticalAlignment="Center" HorizontalAlignment="Center" />

            <StackPanel Name="EmptyState" IsVisible="{Binding ShowEmptyMessage}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" MaxWidth="720">
              <TextBlock Text="{Binding AppName}" Classes="cr-display" HorizontalAlignment="Center" />
              <TextBlock Name="BookCountLabel" Text="{Binding BookCountText}" Classes="cr-hint" HorizontalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Progress of Add Folder to Library / Import: a count, the current file, Cancel. -->
            <Border Name="ProgressPanel" Classes="cr-card" IsVisible="{Binding IsProgressVisible}" Padding="16" Width="560"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
              <StackPanel Spacing="8">
                <TextBlock Name="ProgressTitleLabel" Text="{Binding ProgressTitle}" Classes="cr-bold" />
                <ProgressBar IsIndeterminate="True" />
                <TextBlock Name="ProgressCountLabel" Text="{Binding ProgressCountText}" />
                <TextBlock Name="ProgressFileLabel" Text="{Binding ProgressFileText}" Classes="cr-hint" TextTrimming="PrefixCharacterEllipsis" />
                <Button Name="CancelButton" Content="Cancel" Command="{Binding CancelOperationCommand}" HorizontalAlignment="Right" Width="80" Height="24" />
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </DockPanel>
    </c:CrSizableContainer>

    <!-- panelReader: the reader area, or the Quick Open pane (P5.29) while no book is open. The reader shows the book of the current tab. -->
    <Grid Name="ReaderHost" IsVisible="{Binding ShowReaderArea}">
      <!-- the area has the DataContext of the book it shows (set in code), so its visibility is bound on a wrapper that keeps the window's -->
      <Grid Name="ReaderPaneHost" IsVisible="{Binding ShowReaderPage}">
        <views:ReaderArea Name="ReaderPane" />
      </Grid>
      <Border Name="QuickOpenPane" Classes="cr-reader-paper" IsVisible="{Binding ShowQuickOpen}" />
    </Grid>
  </DockPanel>
</Window>
