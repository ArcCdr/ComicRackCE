<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ComicRack.Mac.ViewModels"
        xmlns:views="using:ComicRack.Mac.Views"
        xmlns:c="clr-namespace:ComicRack.Mac.Controls"
        x:Class="ComicRack.Mac.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Width="1100" Height="720" MinWidth="640" MinHeight="400"
        Classes="cr-window"
        WindowStartupLocation="CenterScreen">
  <!-- The library window as the original's main form shows the browser (MainForm.Designer.cs, ComicExplorerView.Designer.cs, ComicBrowserControl.Designer.cs):
       the side panel (252 wide with a 6 unit grip) on the left, the browser toolbar (25 high) above the book list, the status bar (24 high) at the bottom.
       The menu is the native menu bar (MainMenu.cs). Chrome only through the Cr controls and the cr-* style classes (chrome-architecture.md). -->
  <DockPanel>
    <!-- Status bar (SB.01, SB.04, SB.05): the text of the browser, the segments of the open book, the thumbnail size slider at the right end. -->
    <c:CrStatusBar Name="StatusBar" DockPanel.Dock="Bottom">
      <c:CrStatusSlot Name="SizeSlot" DockPanel.Dock="Right" Width="120" Height="22" Margin="0,1,0,1" Sunken="False">
        <Slider Name="SizeSlider" Width="110" Minimum="80" Maximum="360" Value="{Binding Browser.ThumbnailSize}" VerticalAlignment="Center" />
      </c:CrStatusSlot>
      <TextBlock Name="PageCountSegment" DockPanel.Dock="Right" Text="{Binding PageCountSegmentText}" ToolTip.Tip="{Binding PageCountSegmentTip}" VerticalAlignment="Center" Margin="4,0" />
      <TextBlock Name="PageSegment" DockPanel.Dock="Right" Text="{Binding PageSegmentText}" ToolTip.Tip="{Binding PageSegmentTip}" VerticalAlignment="Center" Margin="4,0" />
      <TextBlock Name="BookSegment" DockPanel.Dock="Right" Text="{Binding BookSegmentText}" ToolTip.Tip="{Binding BookSegmentTip}" VerticalAlignment="Center" Margin="4,0" />
      <TextBlock Name="StatusLabel" Text="{Binding StatusLine}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0" />
    </c:CrStatusBar>

    <!-- Side panel with the library tree (LT.01). The grip (right) resizes it and the Sidebar button, Browse > Sidebar and Shift+F6 collapse it. -->
    <c:CrSizableContainer Name="SidebarPanel" DockPanel.Dock="Left" Grip="Right"
                          ExpandedExtent="{Binding Sidebar.Width, Mode=TwoWay}" IsExpanded="{Binding Sidebar.IsVisible, Mode=TwoWay}">
      <Border Classes="cr-panel">
        <c:CrTreeView Name="SidebarTree" ItemsSource="{Binding Sidebar.Roots}" SelectedItem="{Binding Sidebar.SelectedNode, Mode=TwoWay}"
                      IconMember="IconName" TextMember="Name" CountMember="CountText" CountVisibleMember="HasCount" ToolTipMember="Badge"
                      ChildrenMember="Children" ExpandedMember="IsExpanded" />
      </Border>
    </c:CrSizableContainer>

    <Grid RowDefinitions="Auto,*">
      <!-- Browser toolbar (BT.*): Sidebar, Arrange (the MVP sort), quick search; the other buttons come with the tasks that own them. -->
      <c:CrToolBar Name="BrowserToolBar" Grid.Row="0">
        <c:CrToolButton Name="SidebarButton" IconName="Sidebar" CheckOnClick="True" IsChecked="{Binding Sidebar.IsVisible, Mode=TwoWay}" />
        <c:CrSplitButton Name="ArrangeButton" IconName="SortUp" Text="{Binding Browser.SortName}" />
        <c:CrSearchBox Name="SearchBox" Text="{Binding Browser.SearchText, Mode=TwoWay}" />
      </c:CrToolBar>

      <Grid Name="ContentArea" Grid.Row="1">
        <views:BookGridView Name="BookGrid" DataContext="{Binding Browser}" />

        <!-- What an empty list says: scripts needed, no books, or a failure. -->
        <TextBlock Name="ListNotice" Text="{Binding Sidebar.Notice}" IsVisible="{Binding Sidebar.HasNotice}" TextWrapping="Wrap"
                   MaxWidth="480" TextAlignment="Center" Classes="cr-hint" VerticalAlignment="Center" HorizontalAlignment="Center" />

        <StackPanel Name="EmptyState" IsVisible="{Binding ShowEmptyMessage}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" MaxWidth="720">
          <TextBlock Text="{Binding AppName}" Classes="cr-display" HorizontalAlignment="Center" />
          <TextBlock Name="BookCountLabel" Text="{Binding BookCountText}" Classes="cr-hint" HorizontalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Progress of Add Folder to Library / Import: a count, the current file, Cancel. -->
        <Border Name="ProgressPanel" Classes="cr-card" IsVisible="{Binding IsProgressVisible}" Padding="16" Width="560"
                VerticalAlignment="Center" HorizontalAlignment="Center">
          <StackPanel Spacing="8">
            <TextBlock Name="ProgressTitleLabel" Text="{Binding ProgressTitle}" Classes="cr-bold" />
            <ProgressBar IsIndeterminate="True" />
            <TextBlock Name="ProgressCountLabel" Text="{Binding ProgressCountText}" />
            <TextBlock Name="ProgressFileLabel" Text="{Binding ProgressFileText}" Classes="cr-hint" TextTrimming="PrefixCharacterEllipsis" />
            <Button Name="CancelButton" Content="Cancel" Command="{Binding CancelOperationCommand}" HorizontalAlignment="Right" Width="80" Height="24" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
