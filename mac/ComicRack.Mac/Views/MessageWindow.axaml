<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ComicRack.Mac.Views.MessageWindow"
        Title="ComicRack CE (MVP)"
        Width="480" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="12">
    <TextBlock Name="TitleLabel" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Name="MessageLabel" TextWrapping="Wrap" />
    <Button Name="OkButton" Content="OK" HorizontalAlignment="Right" IsDefault="True" Classes="accent" />
  </StackPanel>
</Window>
