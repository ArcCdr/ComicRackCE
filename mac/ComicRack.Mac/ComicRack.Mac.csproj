<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Avalonia app of the macOS MVP (M2.0a): window, native menu, MacHost lifetime. Library, grid and reader come in M2.1 to M2.3. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ComicRack.Mac</AssemblyName>
    <RootNamespace>ComicRack.Mac</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Avalonia 12 is the latest stable on NuGet (12.1.4, 2026-10-17). Avalonia.Skia 12.1.4 depends on SkiaSharp 3.119.4, the version pinned in mac/Directory.Build.props. -->
    <AvaloniaVersion>12.1.4</AvaloniaVersion>
    <!-- Only the macOS native assets are copied (SkiaSharp would otherwise bring about 275 MB of Windows DLLs). M2.0b publishes with the same runtime identifier. -->
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- SystemPaths builds <ApplicationData>/<company>/<product> from the entry assembly (see "Facts from M1.5a"): no company, product = the MVP data folder. -->
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <Product>ComicRack CE (MVP)</Product>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Native" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.HarfBuzz" Version="$(AvaloniaVersion)" />
    <!-- Only for the headless option (smoke runs when no display is available: locked screen, CI). -->
    <PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <!-- ItemsRepeater and UniformGridLayout are not in the Avalonia 12 core assemblies; this is the official package (12.0.0 is its latest version and needs Avalonia 12.0.0 or later). -->
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="12.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Never a version of its own: the shim (cYo.Compat.Drawing) and Avalonia must use the same Skia. -->
    <PackageReference Include="SkiaSharp" Version="$(SkiaSharpVersion)" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="$(SkiaSharpVersion)" />
  </ItemGroup>
  <!-- P2.6: the payload of ComicRack/Output (never edited) is copied next to the entry assembly, where TRDictionary looks for Languages/, and
       into the publish folder (and so into Contents/MacOS of the bundle). The Windows binaries in Resources/ and Resources/x64 are not named here.
       Help: only the *.ini links (the DjVu introduction is deferred). -->
  <ItemGroup>
    <None Include="..\..\ComicRack\Output\Languages\**" Link="Languages\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\ComicRack\Output\Scripts\**" Link="Scripts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\ComicRack\Output\Help\*.ini" Link="Help\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\ComicRack\Output\DefaultLists.txt" Link="DefaultLists.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\ComicRack\Output\Resources\Icons\**" Link="Resources\Icons\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\ComicRack\Output\Resources\Textures\**" Link="Resources\Textures\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- P5.T2: the images of the WinForms original, linked (never copied or edited) into the assembly as avares://ComicRack.Mac/Assets/Original/<repository path>.
       Assets/icon-map.json (mac/tools/icon-map/icon-map.py) maps the resource names of the four Resources.resx files to these paths; Themes/Icons.cs reads both. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\icon-map.json" />
    <AvaloniaResource Include="..\..\ComicRack\Resources\**" Link="Assets\Original\ComicRack\Resources\%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\..\cYo.Common.Windows\Resources\**" Link="Assets\Original\cYo.Common.Windows\Resources\%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\..\ComicRack.Engine\Resources\**" Link="Assets\Original\ComicRack.Engine\Resources\%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\..\ComicRack.Engine.Display.Forms\Resources\**" Link="Assets\Original\ComicRack.Engine.Display.Forms\Resources\%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\..\ComicRack\Icons\*.ico" Link="Assets\Original\ComicRack\Icons\%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- P4.3: make-app.sh patches IronPython.dll after the publish (mac/tools/patch-ironpython, Mono.Cecil); a ReadyToRun image of it cannot be patched, so it stays plain IL. -->
  <ItemGroup>
    <PublishReadyToRunExclude Include="IronPython.dll" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ComicRack.Mac.Host\ComicRack.Mac.Host.csproj" />
  </ItemGroup>
</Project>
