<Project>
  <!-- Presence of this file stops MSBuild from importing the root directory.build.props. Do not import it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);MACOS</DefineConstants>
    <NoWarn>$(NoWarn);SYSLIB0011;SYSLIB0006;SYSLIB0014;CA1416</NoWarn>
    <!-- One SkiaSharp version for the whole mac/ tree: the Drawing shim and the Avalonia app (Avalonia.Skia 12.1.4 depends on 3.119.4)
         must resolve to the same one. SkiaSharp 4.x exists on NuGet but is not what Avalonia 12 uses, so keep this pinned. -->
    <SkiaSharpVersion>3.119.4</SkiaSharpVersion>
  </PropertyGroup>
</Project>
