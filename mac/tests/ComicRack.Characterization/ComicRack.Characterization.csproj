<Project Sdk="Microsoft.NET.Sdk">
  <!-- Characterization ("golden") tests of the shared Core on net10 (P0.7a): database round trip, list counts, file name parsing, matchers.
       The goldens are committed in Golden/; UPDATE_GOLDENS=1 rewrites them (see Goldens.cs). -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>ComicRack.Characterization</RootNamespace>
    <!-- SkiaSharp depends on the native assets of every platform; without a runtime identifier all of them (about 275 MB of Windows DLLs) are copied to bin/. -->
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Program.cs is the child process of the fresh-process race test (LanguageRaceTests). -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ComicRack.Mac.Host\ComicRack.Mac.Host.csproj" />
  </ItemGroup>
</Project>
