<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of the macOS composition root (ComicRack.Mac.Host): open and close, leaked threads, defaults, error page (M1.5a). -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>ComicRack.Mac.Host.Tests</RootNamespace>
    <!-- SkiaSharp depends on the native assets of every platform; without a runtime identifier all of them (about 275 MB of Windows DLLs) are copied to bin/. -->
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ComicRack.Mac.Host\ComicRack.Mac.Host.csproj" />
    <!-- WindowsTripwireTests generate their books with the code of `crcli fixtures make`. -->
    <ProjectReference Include="..\..\ComicRack.Cli\ComicRack.Cli.csproj" />
    <!-- P4.3: the IronPython patch is called as a library by IronPythonPatchTests. -->
    <ProjectReference Include="..\..\tools\patch-ironpython\patch-ironpython.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Scripting\TestScripts\**" Link="TestScripts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
