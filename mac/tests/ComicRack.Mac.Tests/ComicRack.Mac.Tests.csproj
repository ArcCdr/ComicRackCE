<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of the Avalonia app (M2.1): view models, services and windows on the headless platform (Skia renderer, frames can be saved as PNG). No real window is shown. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>ComicRack.Mac.Tests</RootNamespace>
    <!-- SkiaSharp depends on the native assets of every platform; without a runtime identifier all of them (about 275 MB of Windows DLLs) are copied to bin/. -->
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- The app project is a WinExe; the tests only use its types. -->
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" />
    <!-- Same version as the app (Avalonia.Headless comes with it; named here because the tests use it directly). -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ComicRack.Mac\ComicRack.Mac.csproj" />
    <!-- M2.2c: the sidebar counts are compared with the output of `crcli smartlist`, run in process (Program.Run). -->
    <ProjectReference Include="..\..\ComicRack.Cli\ComicRack.Cli.csproj" />
  </ItemGroup>
</Project>
