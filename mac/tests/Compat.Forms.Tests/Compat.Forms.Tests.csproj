<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Compat.Forms.Tests</RootNamespace>
    <!-- SkiaSharp (through cYo.Compat.Drawing) depends on the native assets of every platform; without a runtime identifier all of them
         (about 275 MB of Windows DLLs) are copied to bin/. -->
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\cYo.Compat.Forms\cYo.Compat.Forms.csproj" />
    <!-- The WPF facades (P4.17.3): only their files are used (Directory.Build.targets keeps them out of the compile references), read with a MetadataLoadContext. -->
    <ProjectReference Include="..\..\cYo.Compat.Xaml\cYo.Compat.Xaml.csproj" />
    <ProjectReference Include="..\..\cYo.Compat.PresentationCore\cYo.Compat.PresentationCore.csproj" />
    <ProjectReference Include="..\..\cYo.Compat.PresentationFramework\cYo.Compat.PresentationFramework.csproj" />
    <!-- The generator is run from the tests (the committed Generated folders must be what it produces now). -->
    <ProjectReference Include="..\..\tools\facade-gen\FacadeGen.csproj" />
  </ItemGroup>
  <!-- The real view-config types, compiled as the Core compiles them (they replace the M0.3b stub). IColumn is the
       reduced stubs of ComicRack.Engine.Core/Replacements, declared again in ColumnStub.cs. -->
  <ItemGroup>
    <Compile Include="..\..\..\cYo.Common.Windows\Forms\ItemViewConfig.cs" Link="Linked\ItemViewConfig.cs" />
    <Compile Include="..\..\..\cYo.Common.Windows\Forms\ItemViewColumnInfo.cs" Link="Linked\ItemViewColumnInfo.cs" />
    <Compile Include="..\..\..\cYo.Common.Windows\Forms\ItemViewMode.cs" Link="Linked\ItemViewMode.cs" />
    <Compile Include="..\..\..\cYo.Common.Windows\Forms\ItemViewGroupsStatus.cs" Link="Linked\ItemViewGroupsStatus.cs" />
    <Compile Include="..\..\..\cYo.Common.Windows\Forms\GroupHeaderInformation.cs" Link="Linked\GroupHeaderInformation.cs" />
  </ItemGroup>
  <!-- The drift guard of the generated facades (P4.7), shared by both test projects. -->
  <ItemGroup>
    <Compile Include="..\Shared\SurfaceComparison.cs" Link="Shared\SurfaceComparison.cs" />
  </ItemGroup>
</Project>
