<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of the upstream sync harness (P0.5a to c): the scan tool runs against synthetic git repositories built in a temp folder. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Upstream.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\tools\upstream-scan\UpstreamScan.csproj" />
    <ProjectReference Include="..\..\tools\api-inventory\ApiInventory.csproj" />
    <!-- Built before the tests (the coverage check reads their output with a MetadataLoadContext); not referenced, so no SkiaSharp native assets are copied here. -->
    <ProjectReference Include="..\..\cYo.Compat.Drawing\cYo.Compat.Drawing.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\cYo.Compat.Forms\cYo.Compat.Forms.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
