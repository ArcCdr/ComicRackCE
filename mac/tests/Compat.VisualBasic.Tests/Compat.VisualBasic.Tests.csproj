<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of mac/cYo.Compat.VisualBasic (P4.17.4): FileSystem with UIOption and RecycleOption over temporary files and a fake Trash, and the drift against the framework's Microsoft.VisualBasic.Core.
       The framework's types are reached as vbcore:: (the framework's FileSystem has the same full name as the one under test). -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Compat.VisualBasic.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\cYo.Compat.VisualBasic\cYo.Compat.VisualBasic.csproj" />
  </ItemGroup>
  <Target Name="AliasVisualBasicCore" BeforeTargets="FindReferenceAssembliesForReferences;ResolveAssemblyReferences" AfterTargets="ResolveTargetingPackAssets">
    <ItemGroup>
      <Reference Condition="'%(Filename)' == 'Microsoft.VisualBasic.Core'" Aliases="vbcore" />
    </ItemGroup>
  </Target>
</Project>
