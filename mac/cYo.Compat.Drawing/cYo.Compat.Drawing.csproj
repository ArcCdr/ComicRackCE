<Project Sdk="Microsoft.NET.Sdk">
  <!-- System.Drawing stand-in for macOS (M1.2a): a custom shim in the literal System.Drawing namespaces, backed by SkiaSharp.
       net10/macOS only: the shadow projects reference it in pass B; the net48 Windows build never sees it.
       Point, Size, Rectangle, Color and the other System.Drawing.Primitives types come from the framework and are not redeclared. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>System.Drawing</RootNamespace>
    <AssemblyName>cYo.Compat.Drawing</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>false</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="$(SkiaSharpVersion)" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="$(SkiaSharpVersion)" />
  </ItemGroup>
</Project>
