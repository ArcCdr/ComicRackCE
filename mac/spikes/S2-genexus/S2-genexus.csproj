<Project Sdk="Microsoft.NET.Sdk">
  <!-- Spike S2 (M0.4): throwaway. Not part of ComicRack.Mac.slnx. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>S2Genexus</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="GeneXus.Drawing.Common" Version="2.2.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" />
  </ItemGroup>
  <!-- Optional run with the SkiaSharp that Avalonia 12 uses: dotnet test -p:SkiaOverride=3.119.4 -->
  <ItemGroup Condition="'$(SkiaOverride)' != ''">
    <PackageReference Include="SkiaSharp" Version="$(SkiaOverride)" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="$(SkiaOverride)" />
  </ItemGroup>
</Project>
