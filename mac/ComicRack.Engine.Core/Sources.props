<Project>
  <!-- Sources and packages of ComicRack.Engine.Core (see cYo.Common.Core/Sources.props). -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\..\ComicRack.Engine\**\*.cs"
             Exclude="$(MSBuildThisFileDirectory)..\..\ComicRack.Engine\Controls\**;$(MSBuildThisFileDirectory)..\..\ComicRack.Engine\Display\ComicDisplay.cs;$(MSBuildThisFileDirectory)..\..\ComicRack.Engine\Display\GestureEventArgs.cs;$(MSBuildThisFileDirectory)..\..\ComicRack.Engine\Drawing\Thumb*Renderer.cs;$(MSBuildThisFileDirectory)..\..\ComicRack.Engine\IO\Network\**;$(MSBuildThisFileDirectory)..\..\ComicRack.Engine\NetworkManager.cs;$(MSBuildThisFileDirectory)..\..\ComicRack.Engine\Sync\DeviceSyncFactory.cs;$(MSBuildThisFileDirectory)..\..\ComicRack.Engine\Sync\PortableDeviceSyncProvider.cs;$(MSBuildThisFileDirectory)..\..\ComicRack.Engine\Database\Storage\ComicStorageMsSql.cs;$(MSBuildThisFileDirectory)..\..\ComicRack.Engine\Drawing\ViewItemRenderer.cs;$(MSBuildThisFileDirectory)..\..\ComicRack.Engine\obj\**;$(MSBuildThisFileDirectory)..\..\ComicRack.Engine\bin\**;$(MSBuildThisFileDirectory)..\..\ComicRack.Engine\Properties\AssemblyInfo.cs"
             LinkBase="Engine" />
    <!-- Real view-config types of cYo.Common.Windows (serialized inside DisplayListConfig and StacksConfig in ComicDb.xml).
         None of them needs a control: they replace the M0.3b ItemViewConfig stub (M1.1). -->
    <Compile Include="$(MSBuildThisFileDirectory)..\..\cYo.Common.Windows\Forms\ItemViewConfig.cs" Link="CommonWindows\ItemViewConfig.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\cYo.Common.Windows\Forms\ItemViewColumnInfo.cs" Link="CommonWindows\ItemViewColumnInfo.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\cYo.Common.Windows\Forms\ItemViewMode.cs" Link="CommonWindows\ItemViewMode.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\cYo.Common.Windows\Forms\ItemViewGroupsStatus.cs" Link="CommonWindows\ItemViewGroupsStatus.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\cYo.Common.Windows\Forms\GroupHeaderInformation.cs" Link="CommonWindows\GroupHeaderInformation.cs" />
    <!-- Real renderer image types of cYo.Common.Presentation (MemoryOptimizedImage derives from RendererImage); they use only Bitmap and
         cYo.Common.ComponentModel. They replace the M0.3b RendererImage stub (M1.3). -->
    <Compile Include="$(MSBuildThisFileDirectory)..\..\cYo.Common.Presentation\RendererImage.cs" Link="Presentation\RendererImage.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\cYo.Common.Presentation\RendererGdiImage.cs" Link="Presentation\RendererGdiImage.cs" />
    <!-- Declarations that stand in for excluded or missing types (see mac/reports/census.md) -->
    <Compile Include="$(MSBuildThisFileDirectory)Replacements\**\*.cs" Exclude="$(MSBuildThisFileDirectory)Replacements\PassB\**" />
  </ItemGroup>
  <!-- Pass B only: pass A compiles the original (it is the basis of the API inventory), pass B cannot (sharpPDF binds to the framework System.Drawing). -->
  <ItemGroup Condition="'$(CensusPass)' == 'B'">
    <Compile Remove="$(MSBuildThisFileDirectory)..\..\ComicRack.Engine\IO\Provider\Writers\PdfStorageProvider.cs" />
    <!-- CacheManager creates the ImagePool inside its constructor; the replacement creates a MacImagePool (error page without text, M1.5a). -->
    <Compile Remove="$(MSBuildThisFileDirectory)..\..\ComicRack.Engine\CacheManager.cs" />
    <!-- PDFiumSharpV2 throws PlatformNotSupportedException on arm64: the replacement calls libpdfium directly (M1.4). -->
    <Compile Remove="$(MSBuildThisFileDirectory)..\..\ComicRack.Engine\IO\Provider\Readers\Pdf\PdfiumReaderEngine.cs" />
    <!-- Thread.Abort is not supported on .NET 10: the replacement of Stop reports and abandons a scanning thread that ignores its timeout (P1.1). -->
    <Compile Remove="$(MSBuildThisFileDirectory)..\..\ComicRack.Engine\ComicScanner.cs" />
    <!-- 7z.exe and the backslash paths under Resources do not exist on macOS: the copy looks for the bundled 7zz (P2.4b). -->
    <Compile Remove="$(MSBuildThisFileDirectory)..\..\ComicRack.Engine\IO\Provider\Readers\Archive\SevenZipEngine.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Replacements\PassB\**\*.cs" />
    <!-- Resources.Designer.cs reads ResXFileRef bitmaps of the framework's System.Drawing.Bitmap: replaced by Replacements\PassB\Resources.cs,
         which decodes the raw files below through the Drawing shim. -->
    <Compile Remove="$(MSBuildThisFileDirectory)..\..\ComicRack.Engine\Properties\Resources.Designer.cs" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\ComicRack.Engine\Resources\*.png;$(MSBuildThisFileDirectory)..\..\ComicRack.Engine\Resources\*.jpg"
                      LogicalName="ComicRack.Engine.Resources.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="sharpPDF">
      <HintPath>$(MSBuildThisFileDirectory)..\..\ComicRack.Engine\DLL\sharpPDF.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- Same as ComicRack.Engine.csproj, with bblanchon.PDFium.macOS (same version) instead of bblanchon.PDFium.Win32 (M1.4) -->
    <PackageReference Include="bblanchon.PDFium.macOS" Version="153.0.7999" />
    <PackageReference Include="CSJ2K" Version="3.0.0" />
    <PackageReference Include="LibHeifSharp" Version="3.2.0" />
    <PackageReference Include="Microsoft.Bcl.Numerics" Version="10.0.10" />
    <PackageReference Include="MySqlConnector" Version="2.6.1" />
    <PackageReference Include="PDFiumSharpV2" Version="1.1.4" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>
</Project>
