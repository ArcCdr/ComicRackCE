<Project>
  <!-- Sources and packages of cYo.Common.Core. Imported by its own project, and by downstream shadow
       projects in merged census mode (CensusMerged=true), so that errors in Common do not hide errors
       in the projects that depend on it. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\..\cYo.Common\**\*.cs"
             Exclude="$(MSBuildThisFileDirectory)..\..\cYo.Common\Win32\PortableDevices\**;$(MSBuildThisFileDirectory)..\..\cYo.Common\Reflection\CodeDomDuckTypeGenerator.cs;$(MSBuildThisFileDirectory)..\..\cYo.Common\Win32\MemoryInfo.cs;$(MSBuildThisFileDirectory)..\..\cYo.Common\Runtime\SingleInstance.cs;$(MSBuildThisFileDirectory)..\..\cYo.Common\Runtime\ISingleInstance.cs;$(MSBuildThisFileDirectory)..\..\cYo.Common\obj\**;$(MSBuildThisFileDirectory)..\..\cYo.Common\bin\**;$(MSBuildThisFileDirectory)..\..\cYo.Common\Properties\AssemblyInfo.cs"
             LinkBase="Common" />
    <!-- Declarations that stand in for excluded or missing types (see mac/reports/census.md) -->
    <Compile Include="$(MSBuildThisFileDirectory)Replacements\**\*.cs" Exclude="$(MSBuildThisFileDirectory)Replacements\PassB\**" />
  </ItemGroup>
  <!-- Pass B only: pass A compiles the originals (they are the basis of the API inventory and build against the real WinForms). -->
  <ItemGroup Condition="'$(CensusPass)' == 'B'">
    <Compile Remove="$(MSBuildThisFileDirectory)..\..\cYo.Common\Drawing\ExtendedColors\KnownColorTableEx.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)..\..\cYo.Common\Win32\UserCredentialsDialog.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)..\..\cYo.Common\Win32\FileSystemEnumerable.cs" />
    <!-- Thread.Abort is not supported on .NET 10: the replacements report and abandon a thread that ignores its timeout (P1.1). -->
    <Compile Remove="$(MSBuildThisFileDirectory)..\..\cYo.Common\Threading\ThreadUtility.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)..\..\cYo.Common\Threading\BackgroundRunner.cs" />
    <!-- Properties\Resources.Designer.cs reads ResXFileRef bitmaps of the framework's System.Drawing.Bitmap: replaced by Replacements\PassB\Resources.cs (P1.3).
         PathGetCharType is a shlwapi P/Invoke: FileUtility.cs is a patched copy with a managed table (P1.3). -->
    <Compile Remove="$(MSBuildThisFileDirectory)..\..\cYo.Common\Properties\Resources.Designer.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)..\..\cYo.Common\IO\FileUtility.cs" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\cYo.Common\Resources\*.png;$(MSBuildThisFileDirectory)..\..\cYo.Common\Resources\*.bmp"
                      LogicalName="cYo.Common.Resources.%(Filename)%(Extension)" />
    <Compile Include="$(MSBuildThisFileDirectory)Replacements\PassB\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Same as cYo.Common.csproj, minus System.Management -->
    <PackageReference Include="DynamicExpresso.Core" Version="2.19.3" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="System.Text.Json" Version="10.0.10" />
  </ItemGroup>
</Project>
