<Project Sdk="Microsoft.NET.Sdk">
  <!-- Throwing facade of the reference assembly System.Xaml of the Windows Desktop pack (P4.17.3), generated by mac/tools/facade-gen into Generated/. Scripts of the .NET Framework
       name the WPF assemblies at the top level (clr.AddReference('System.Xaml')); without them such a plug-in does not load at all. net10/macOS only; the net48 build never sees it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>System.Xaml</RootNamespace>
    <AssemblyName>System.Xaml</AssemblyName>
    <AssemblyVersion>10.0.0.0</AssemblyVersion>
    <FileVersion>10.0.0.0</FileVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>false</Deterministic>
  </PropertyGroup>

  <!-- The generated bodies of a derived class call internal constructors of its base in another facade (WPF reaches them through InternalsVisibleTo too). -->
  <ItemGroup>
    <InternalsVisibleTo Include="PresentationCore" />
    <InternalsVisibleTo Include="PresentationFramework" />
  </ItemGroup>
</Project>
