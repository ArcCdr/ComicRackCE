<Project Sdk="Microsoft.NET.Sdk">
  <!-- Types-only stand-in for the slice of System.Windows.Forms that the Core uses (M1.1). net10/macOS only:
       the shadow projects reference it in pass B; the net48 Windows build never sees it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>System.Windows.Forms</RootNamespace>
    <AssemblyName>System.Windows.Forms</AssemblyName>
    <AssemblyVersion>10.0.0.0</AssemblyVersion>
    <FileVersion>10.0.0.0</FileVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>false</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <!-- Cursor.Draw(Graphics, Rectangle) needs System.Drawing.Graphics (M1.2a). -->
    <ProjectReference Include="..\cYo.Compat.Drawing\cYo.Compat.Drawing.csproj" />
  </ItemGroup>
</Project>
