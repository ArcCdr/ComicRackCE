<Project Sdk="Microsoft.NET.Sdk">
  <!-- crcli: command line tool of the macOS build. M1.6 added the `fixtures` commands (Skia and SharpZipLib only); M1.5b adds the Core commands (`db`, `scan`, `page`, `thumb`) on ComicRack.Mac.Host. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>crcli</AssemblyName>
    <RootNamespace>ComicRack.Cli</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- SkiaSharp depends on the native assets of every platform; without a runtime identifier about 275 MB of Windows DLLs land in bin/. -->
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- SystemPaths builds <ApplicationData>/<company>/<product> from the entry assembly (see "Facts from M1.5a"): no company, product = the MVP data folder. -->
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <Product>ComicRack CE (MVP)</Product>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="$(SkiaSharpVersion)" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="$(SkiaSharpVersion)" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <InternalsVisibleTo Include="ComicRack.Cli.Tests" />
  </ItemGroup>
  <!-- P4.3: the scripts that come with the program, next to crcli (as in the app, P2.6), for `smartlist` and `script`. -->
  <ItemGroup>
    <None Include="..\..\ComicRack\Output\Scripts\**" Link="Scripts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ComicRack.Mac.Host\ComicRack.Mac.Host.csproj" />
  </ItemGroup>
</Project>
