<Project>
  <!-- P4.3: IronPython 2.7.12 cannot create a Python class on .NET 9 and later (mac/reports/s4-ironpython.md). Every project whose output folder holds
       IronPython.dll (the app, crcli and the test projects: a library project does not copy package assemblies) patches that copy after the build
       with mac/tools/patch-ironpython (Mono.Cecil, idempotent). The tool is built before, through a project reference of ComicRack.Plugins.Core, which every
       project that holds IronPython.dll depends on. mac/tools/make-app.sh patches the copy in the bundle. Spikes keep the stock file (PatchIronPython=false). -->
  <PropertyGroup>
    <PatchIronPythonTool>$(MSBuildThisFileDirectory)tools\patch-ironpython\bin\$(Configuration)\net10.0\patch-ironpython.dll</PatchIronPythonTool>
    <PatchIronPythonHost>$(DOTNET_HOST_PATH)</PatchIronPythonHost>
    <PatchIronPythonHost Condition="'$(PatchIronPythonHost)' == ''">dotnet</PatchIronPythonHost>
  </PropertyGroup>
  <Target Name="PatchIronPython" AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(PatchIronPython)' != 'false' And !$(MSBuildProjectDirectory.Contains('spikes')) And Exists('$(OutDir)IronPython.dll')">
    <Error Condition="!Exists('$(PatchIronPythonTool)')" Text="IronPython.dll cannot be patched: $(PatchIronPythonTool) is missing (build mac/tools/patch-ironpython first)." />
    <Exec Command="&quot;$(PatchIronPythonHost)&quot; &quot;$(PatchIronPythonTool)&quot; &quot;$(OutDir)IronPython.dll&quot;" StandardOutputImportance="low" />
  </Target>
  <!-- P4.17.3: the WPF facades (System.Xaml, PresentationCore with the types of WindowsBase, PresentationFramework) are runtime files only. A project that merely uses ComicRack.Mac.Host would otherwise
       see System.Windows.Input.Key and KeyBinding next to Avalonia's. Only the facade projects themselves (they reference each other) and a project that sets WpfFacadesVisible=true compile against them. -->
  <Target Name="HideWpfFacadesFromCompile" BeforeTargets="CoreCompile"
          Condition="'$(WpfFacadesVisible)' != 'true' And !$(MSBuildProjectName.StartsWith('cYo.Compat.'))">
    <ItemGroup>
      <_WpfFacadeReference Include="@(ReferencePathWithRefAssemblies)" Condition="$([System.String]::Copy('%(FullPath)').Contains('cYo.Compat.')) And ('%(Filename)' == 'System.Xaml' Or '%(Filename)' == 'PresentationCore' Or '%(Filename)' == 'PresentationFramework')" />
      <ReferencePathWithRefAssemblies Remove="@(_WpfFacadeReference)" />
    </ItemGroup>
  </Target>
</Project>
